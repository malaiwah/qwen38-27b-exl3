# ─── docker-compose environment ────────────────────────────────────────────
# Copy to .env and adjust for your machine.

# HuggingFace model cache directory (contains model weights)
HF_CACHE_DIR=/home/ubuntu/.cache/huggingface/hub

# Directory containing the patch files (vllm-exl3-multiprecision.py, etc.)
PATCHES_DIR=./patches

# JIT compilation cache (persists across restarts for faster boot)
JIT_CACHE_DIR=./cache/jit

# API server port
PORT=8000
