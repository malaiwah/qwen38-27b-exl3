Sending keys: ['cat > /app/headless_terminal.py <<\'PYEOF\'\n"""Headless terminal that mimics an interactive bash shell.\n\nThis module provides :class:`HeadlessTerminal`, a concrete implementation of\n:class:`BaseTerminal`.\n\nIt spawns a real interactive ``bash`` shell wired to a pseudo-terminal (pty)\nbehind the scenes, which gives us all the behaviour of an actual terminal:\n\n* **Mimics a terminal** - commands are executed by typing characters and\n  pressing Enter; input is echoed and a prompt is shown.\n* **Interactive programs** - because the shell (and anything it runs) is\n  attached to a genuine tty, programs such as ``vim``, ``top``, ``less`` or\n  ``cat`` behave as they would in a real terminal.\n* **Modifier / control keys** - the pty line discipline interprets control\n  characters, e.g. ``"\\\\x03"`` is Ctrl-C, ``"\\\\x04"`` is Ctrl-D, ``"\\\\x1b"``\n  is Escape, arrow keys are ``"\\\\x1b[A"`` etc.\n* **Startup files** - the shell is an *interactive, non-login* shell, exactly\n  like a normal terminal tab, so it sources ``~/.bashrc`` (and friends).\n"""\n\nimport errno\nimport fcntl\nimport os\nimport re\nimport shlex\nimport sys\nimport threading\nimport time\n\n# Make sure the directory containing this module is importable so that\n# ``base_terminal`` (which lives alongside us) can always be found.\n_this_dir = os.path.dirname(os.path.abspath(__file__))\nif _this_dir not in sys.path:\n    sys.path.insert(0, _this_dir)\n\ntry:\n    import ptyprocess\nexcept ImportError as exc:  # pragma: no cover - dependency guard\n    raise ImportError(\n        "The \'ptyprocess\' package is required by headless_terminal. "\n        "Install it with:  pip install pexpect ptyprocess"\n    ) from exc\n\nfrom base_terminal import BaseTerminal\n\n\n__all__ = ["HeadlessTerminal"]\n\n\nclass HeadlessTerminal(BaseTerminal):\n    """A headless interactive bash terminal.\n\n    Example\n    -------\n    >>> term = HeadlessTerminal()\n    >>> term.send_keystrokes("echo hello\\\\n", wait_sec=1.0)\n    >>> "hello" in term.output\n    True\n    >>> term.send_keystrokes("\\\\x03", wait_sec=0.2)   # Ctrl-C\n    >>> term.close()\n    """\n\n    def __init__(\n        self,\n        command=None,\n        rows=24,\n        cols=80,\n        cwd=None,\n        env=None,\n        encoding="utf-8",\n    ):\n        """Create a new headless terminal.\n\n        Args:\n            command: The command to run. Defaults to an interactive bash shell\n                (``["bash", "-i"]``). May be a string (split with\n                :func:`shlex.split`) or a list of arguments.\n            rows: Initial terminal height (in lines).\n            cols: Initial terminal width (in columns).\n            cwd: Working directory for the spawned shell.\n            env: Environment variables. Defaults to a copy of the current\n                environment with a few sensible terminal-related defaults added.\n            encoding: Encoding used to decode terminal output (default utf-8).\n        """\n        if command is None:\n            # An *interactive, non-login* shell - this is what a normal\n            # terminal tab runs, and it is what sources ``~/.bashrc``.\n            command = ["bash", "-i"]\n        elif isinstance(command, str):\n            command = shlex.split(command)\n        else:\n            command = list(command)\n\n        self._rows = int(rows)\n        self._cols = int(cols)\n        self._encoding = encoding\n\n        # Build the child environment. A real terminal always defines TERM and\n        # friends, so make sure those are present for interactive programs.\n        if env is None:\n            env = os.environ.copy()\n        else:\n            env = dict(env)\n        env.setdefault("TERM", "xterm-256color")\n        env.setdefault("HOME", os.path.expanduser("~"))\n        env.setdefault("USER", os.environ.get("USER", "root"))\n        env.setdefault("SHELL", "/bin/bash")\n        env.setdefault("PATH", "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")\n        env.setdefault("COLUMNS", str(self._cols))\n        env.setdefault("LINES", str(self._rows))\n\n        # Spawn the shell on a pty.\n        self._proc = ptyprocess.PtyProcess.spawn(\n            command,\n            dimensions=(self._rows, self._cols),\n            cwd=cwd,\n            env=env,\n        )\n\n        # Make the master fd non-blocking so the reader thread can poll.\n        fd = self._proc.fd\n        try:\n            flags = fcntl.fcntl(fd, fcntl.F_GETFL)\n            fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)\n        except OSError:\n            pass\n\n        self._lock = threading.RLock()\n        self._cond = threading.Condition(self._lock)\n        self._buffer = b""\n        self._stop_event = threading.Event()\n        self._closed = False\n        self._alive = True\n\n        self._reader = threading.Thread(\n            target=self._reader_loop,\n            name="HeadlessTerminal-reader",\n            daemon=True,\n        )\n        self._reader.start()\n\n    # ------------------------------------------------------------------ #\n    # Internal helpers\n    # ------------------------------------------------------------------ #\n    def _reader_loop(self):\n        """Continuously drain the pty into :attr:`_buffer`.\n\n        Running this in a background thread is essential: if the pty is not\n        read from, its kernel buffer fills up and the child process blocks on\n        ``write()``.  The loop terminates when the pty reaches EOF (the shell\n        and all of its tty-holding children have exited) or when :meth:`close`\n        is called.\n        """\n        fd = self._proc.fd\n        while not self._stop_event.is_set():\n            try:\n                data = os.read(fd, 65536)\n                eof = data == b""\n            except OSError as exc:\n                if exc.errno in (errno.EAGAIN, errno.EWOULDBLOCK, errno.EINTR):\n                    data = b""\n                    eof = False\n                else:\n                    break\n\n            if data:\n                with self._cond:\n                    self._buffer += data\n                    self._cond.notify_all()\n\n            if eof:\n                break\n            if not data:\n                # Nothing to read right now - back off briefly so we do not\n                # spin the CPU when the terminal is idle.\n                time.sleep(0.002)\n\n        self._drain_remaining()\n        with self._cond:\n            self._alive = False\n            self._cond.notify_all()\n\n    def _drain_remaining(self):\n        """Read any bytes still sitting in the pty buffer."""\n        fd = self._proc.fd\n        try:\n            while True:\n                try:\n                    data = os.read(fd, 65536)\n                except OSError as exc:\n                    if exc.errno in (errno.EAGAIN, errno.EWOULDBLOCK, errno.EINTR):\n                        data = b""\n                    else:\n                        break\n                if data:\n                    with self._cond:\n                        self._buffer += data\n                        self._cond.notify_all()\n                else:\n                    break\n        except Exception:\n            pass\n\n    def _write(self, data):\n        """Write *data* (bytes) to the pty, handling partial writes."""\n        if self._closed:\n            raise OSError("Terminal is closed")\n        fd = self._proc.fd\n        view = memoryview(data)\n        while view:\n            try:\n                written = os.write(fd, view)\n            except OSError as exc:\n                if exc.errno in (errno.EAGAIN, errno.EWOULDBLOCK, errno.EINTR):\n                    time.sleep(0.005)\n                    continue\n                raise\n            view = view[written:]\n\n    # ------------------------------------------------------------------ #\n    # Public API\n    # ------------------------------------------------------------------ #\n    def send_keystrokes(self, keystrokes: str, wait_sec: float = 0.0) -> None:\n        """Send keystrokes to the terminal.\n\n        Args:\n            keystrokes: The keystrokes to send. Plain text is encoded and\n                written to the pty, so it also accepts control / modifier\n                characters such as ``"\\\\x03"`` (Ctrl-C), ``"\\\\x04"``\n                (Ctrl-D) or ``"\\\\x1b[A"`` (up arrow). ``bytes`` are passed\n                through untouched.\n            wait_sec: How long (seconds) to wait after sending, giving the\n                shell/program time to react. Defaults to 0 (no wait).\n        """\n        if isinstance(keystrokes, (bytes, bytearray)):\n            data = bytes(keystrokes)\n        else:\n            data = str(keystrokes).encode(self._encoding, errors="replace")\n        self._write(data)\n        if wait_sec and wait_sec > 0:\n            time.sleep(float(wait_sec))\n\n    def sendline(self, line, wait_sec: float = 0.0):\n        """Send *line* followed by a newline (Enter)."""\n        self.send_keystrokes(line + "\\n", wait_sec=wait_sec)\n\n    def run(self, command, wait_sec: float = 0.0):\n        """Type *command* and press Enter (alias of :meth:`sendline`)."""\n        self.sendline(command, wait_sec=wait_sec)\n\n    def get_output(self, clear: bool = False) -> str:\n        """Return all output received so far (decoded text).\n\n        Args:\n            clear: If True, empty the internal buffer after reading.\n        """\n        with self._cond:\n            data = self._buffer\n            if clear:\n                self._buffer = b""\n        return data.decode(self._encoding, errors="replace")\n\n    @property\n    def output(self) -> str:\n        """The full output received so far, as decoded text."""\n        return self.get_output()\n\n    @property\n    def buffer(self) -> bytes:\n        """The full output received so far, as raw bytes."""\n        with self._cond:\n            return self._buffer\n\n    def read_output(self, size=None) -> str:\n        """Consume up to *size* characters of output (or all of it)."""\n        with self._cond:\n            if size is None:\n                data = self._buffer\n                self._buffer = b""\n            else:\n                data = self._buffer[:size]\n                self._buffer = self._buffer[size:]\n        return data.decode(self._encoding, errors="replace")\n\n    def get_screen(self, lines: int = None) -> str:\n        """Return the last *lines* of output (or all of it if None)."""\n        text = self.get_output()\n        if lines is None:\n            return text\n        return "\\n".join(text.splitlines()[-lines:])\n\n    def clear(self):\n        """Discard any buffered output."""\n        with self._cond:\n            self._buffer = b""\n\n    def expect(self, pattern, timeout: float = 10.0):\n        """Wait until *pattern* appears in the output and return the match.\n\n        Args:\n            pattern: A plain string (treated as a literal substring) or a\n                compiled :class:`re.Pattern`.\n            timeout: Seconds to wait before raising :class:`TimeoutError`.\n        """\n        if isinstance(pattern, re.Pattern):\n            rx = pattern\n        elif isinstance(pattern, str):\n            rx = re.compile(re.escape(pattern))\n        else:\n            rx = re.compile(re.escape(bytes(pattern)))\n\n        if timeout is None or timeout <= 0:\n            deadline = float("inf")\n        else:\n            deadline = time.monotonic() + timeout\n\n        while True:\n            with self._cond:\n                hay = self._buffer\n            match = rx.search(hay)\n            if match:\n                return match.group(0)\n            if time.monotonic() >= deadline:\n                raise TimeoutError(f"Timed out waiting for {pattern!r}")\n            with self._cond:\n                remaining = deadline - time.monotonic()\n                if remaining > 0:\n                    self._cond.wait(min(remaining, 0.1))\n\n    # Backwards-/usage-friendly aliases.\n    wait_for = expect\n\n    def is_alive(self) -> bool:\n        """Return True while the shell process is running."""\n        if self._closed:\n            return False\n        try:\n            return self._proc.isalive()\n        except Exception:\n            return False\n\n    @property\n    def pid(self):\n        """The PID of the spawned shell process."""\n        return self._proc.pid\n\n    @property\n    def size(self):\n        """Current terminal size as a ``(rows, cols)`` tuple."""\n        return (self._rows, self._cols)\n\n    def resize(self, rows, cols):\n        """Change the terminal size (triggers SIGWINCH in the shell)."""\n        self._rows = int(rows)\n        self._cols = int(cols)\n        try:\n            self._proc.setwinsize(self._rows, self._cols)\n        except (OSError, AttributeError):\n            pass\n\n    def close(self):\n        """Terminate the shell and release all resources."""\n        if self._closed:\n            return\n        self._closed = True\n        self._stop_event.set()\n\n        proc = self._proc\n        try:\n            if proc.isalive():\n                try:\n                    proc.terminate()\n                except Exception:\n                    pass\n                for _ in range(20):\n                    try:\n                        if not proc.isalive():\n                            break\n                    except Exception:\n                        break\n                    time.sleep(0.05)\n                try:\n                    if proc.isalive():\n                        proc.kill()\n                except Exception:\n                    pass\n            proc.wait()\n        except Exception:\n            pass\n\n        if self._reader.is_alive():\n            self._reader.join(timeout=1.0)\n\n        try:\n            proc.close()\n        except Exception:\n            pass\n\n    # Context-manager support.\n    def __enter__(self):\n        return self\n\n    def __exit__(self, exc_type, exc, tb):\n        self.close()\n        return False\n\n    def __del__(self):  # pragma: no cover - best effort cleanup\n        try:\n            self.close()\n        except Exception:\n            pass\nPYEOF\necho "written: $(wc -l < /app/headless_terminal.py) lines"\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
