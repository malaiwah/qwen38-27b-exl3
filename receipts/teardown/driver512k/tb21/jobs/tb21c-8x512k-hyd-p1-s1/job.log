Sending keys: ["cat > /tmp/solver.py << 'PYEOF'\nimport re, subprocess, os\nfrom parasolve import SYN, PAT, paragraphs, overfulls, para_tex, preamble, PT, APP\nimport copy\n\nos.makedirs(PT, exist_ok=True)\n\ndef distinct_changeable(text):\n    return set(PAT.findall(text))\n\ndef apply_map(text, m):\n    def repl(mm):\n        w=mm.group(0)\n        if w.lower() in m:\n            rep=m[w.lower()]\n            if w[0].isupper(): rep=rep[0].upper()+rep[1:]\n            return rep\n        return w\n    return PAT.sub(repl, text)\n\ndef cost_of(text):\n    of=overfulls(para_tex(text))\n    return sum(x for x,_ in of), of\n\ndef solve(para_idx, budget=400):\n    orig=paragraphs()[para_idx-1]\n    words=distinct_changeable(orig)\n    # init: all-shortest (only words that have a shorter/equal synonym)\n    init={}\n    for W in words:\n        cands=[s for s in SYN[W] if len(s)<=len(W) and s!=W]\n        if cands:\n            init[W.lower()]=min(cands,key=len)\n    cur=apply_map(orig, init)\n    tot,of=cost_of(cur)\n    print(f'\\n--- P{para_idx} start all-shortest overfull={tot:.3f} ({len(of)} lines)')\n    it=0; evals=1; improved=True\n    while tot>0 and it<12 and evals<budget:\n        improved=False; best=None\n        for W in sorted(words):\n            cands=[s for s in SYN[W] if len(s)<=len(W) and s!=W]\n            cands=[W]+cands  # allow original too\n            for s in cands:\n                m=copy.deepcopy(init); m[W.lower()]=s\n                txt=apply_map(orig,m)\n                t2,of2=cost_of(txt); evals+=1\n                if best is None or t2<best[0]:\n                    best=(t2,m,txt)\n        if best and best[0]<tot:\n            tot,init,cur=best[0],best[1],best[2]\n            it+=1; improved=True\n            print(f'   it{it} -> overfull={tot:.3f}  (changed: { {k:v for k,v in init.items() if v!=k} })')\n        else:\n            break\n    tot_final,of_final=cost_of(cur)\n    final_changed={k:v for k,v in init.items() if v!=k}\n    print(f'   RESULT P{para_idx}: overfull={tot_final:.3f} ({len(of_final)} lines) evals={evals} changed={final_changed}')\n    return final_changed, cur, tot_final\n\nif __name__=='__main__':\n    results={}\n    for pi in [3,4,7,10]:\n        ch,txt,tot=solve(pi)\n        results[pi]=(ch,txt,tot)\n    print('\\n==== SUMMARY ====')\n    for pi in [3,4,7,10]:\n        print(f'P{pi}: overfull={results[pi][2]:.3f}')\n    import pickle\n    with open('/tmp/results.pkl','wb') as f:\n        pickle.dump({pi:{'changed':results[pi][0],'text':results[pi][1]} for pi in results}, f)\nPYEOF\npython3 /tmp/solver.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
