Sending keys: ['cat > /app/_test_headless.py <<\'PYEOF\'\nimport os, tempfile, time\nfrom headless_terminal import HeadlessTerminal\n\ndef show(label, s):\n    print(f"===== {label} =====")\n    print(repr(s[-400:]))\n    print()\n\n# ---- 1. Basic terminal behaviour: type chars + Enter ----\nt = HeadlessTerminal()\nt.send_keystrokes("echo hello_world_123\\n", wait_sec=1.0)\nout = t.output\nassert "hello_world_123" in out, "echo output missing"\nshow("1 basic", out)\nt.close()\n\n# ---- 2. Interactive program (reads stdin) ----\nt = HeadlessTerminal()\nt.send_keystrokes("cat\\n", wait_sec=0.5)\nt.send_keystrokes("first_line\\n", wait_sec=0.3)\nt.send_keystrokes("second_line\\n", wait_sec=0.3)\nt.send_keystrokes("\\x04", wait_sec=0.5)  # EOF -> cat exits\nout = t.output\nassert "first_line" in out and "second_line" in out, "interactive cat failed"\nshow("2 interactive", out)\nt.close()\n\n# ---- 3. Control key: Ctrl-C interrupts a running command ----\nt = HeadlessTerminal()\nt.send_keystrokes("sleep 30\\n", wait_sec=0.5)\nbefore = t.output\nt.send_keystrokes("\\x03", wait_sec=0.8)  # Ctrl-C\nafter = t.output\n# After Ctrl-C the shell should show a new prompt ($). Check we got more output.\nassert "sleep 30" in before\nshow("3 ctrl-c", after)\n# The interrupt should have produced a new prompt after the command line.\nt.close()\n\n# ---- 4. .bashrc is sourced (interactive, non-login shell) ----\ntmp = tempfile.mkdtemp()\nmarker = "MARKER_FROM_BASHRC_7788"\nwith open(os.path.join(tmp, ".bashrc"), "w") as f:\n    f.write(f"export MYPYTEST={marker}\\n")\nt = HeadlessTerminal(env=dict(os.environ, HOME=tmp))\nt.send_keystrokes("echo $MYPYTEST\\n", wait_sec=1.0)\nout = t.output\nassert marker in out, f".bashrc not sourced; output={out!r}"\nshow("4 bashrc", out)\nt.close()\n\nprint("ALL TESTS PASSED")\nPYEOF\ncd /app && python3 _test_headless.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
