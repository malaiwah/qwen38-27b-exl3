og if 'Overfull' in l]\nprint('=== FULL DOC OVERFULLS:',len(of),'===')\nfor i,l in enumerate(log):\n    if 'Overfull' in l:\n        print('  ',l.strip(),'||',log[i+1].strip() if i+1<len(log) else '')\nprint('EXIT', r.returncode, '| Output written:', [l for l in log if 'Output written' in l])\nPYEOF\npython3 /tmp/assemble.py\n"] min_timeout_sec: 8.0 max_timeout_sec: 180.0
