Sending keys: ["cat > /app/parallel_linear.py << 'PYEOF'\n'''\nTensor-parallel linear layers (column / row parallelism) for PyTorch.\n\nColumnParallelLinear shards the output dimension; each rank keeps\nout_features // world_size output units (and the matching bias slice) and the\nfull output is reconstructed with an all_gather along the last dimension.\n\nRowParallelLinear shards the input dimension; forward expects the input to be\nalready scattered along the last dimension, the partial outputs are combined\nwith an all_reduce (sum) and the full bias is added afterwards.\n'''\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torch.distributed as dist\n\n__all__ = ['ColumnParallelLinear', 'RowParallelLinear']\n\n\ndef _world_size():\n    try:\n        return dist.get_world_size()\n    except Exception:\n        return 1\n\n\ndef _rank():\n    try:\n        return dist.get_rank()\n    except Exception:\n        return 0\n\n\ndef _communicate():\n    if not dist.is_available() or not dist.is_initialized():\n        return False\n    return _world_size() > 1\n\n\ndef _shard(tensor, dim, world_size, rank):\n    if world_size <= 1:\n        return tensor\n    size = tensor.size(dim)\n    local_size = size // world_size\n    start = rank * local_size\n    return tensor.narrow(dim, start, local_size).contiguous()\n\n\ndef _all_reduce(tensor):\n    if not _communicate():\n        return tensor\n    out = tensor.contiguous().clone()\n    dist.all_reduce(out, op=dist.ReduceOp.SUM)\n    return out\n\n\ndef _all_gather(tensor):\n    if not _communicate():\n        return tensor\n    world_size = _world_size()\n    dim = tensor.dim() - 1\n    gathered = [torch.empty_like(tensor) for _ in range(world_size)]\n    dist.all_gather(gathered, tensor.contiguous())\n    return torch.cat(gathered, dim=dim)\n\n\nclass _ReduceFromParallelRegion(torch.autograd.Function):\n    @staticmethod\n    def forward(ctx, tensor):\n        return _all_reduce(tensor)\n\n    @staticmethod\n    def backward(ctx, grad_output):\n        return grad_output\n\n\nclass _GatherFromParallelRegion(torch.autograd.Function):\n    @staticmethod\n    def forward(ctx, tensor):\n        return _all_gather(tensor)\n\n    @staticmethod\n    def backward(ctx, grad_output):\n        if not _communicate():\n            return grad_output\n        world_size = _world_size()\n        rank = _rank()\n        dim = grad_output.dim() - 1\n        local_size = grad_output.size(dim) // world_size\n        start = rank * local_size\n        return grad_output.narrow(dim, start, local_size).contiguous()\n\n\ndef _reduce(tensor):\n    return _ReduceFromParallelRegion.apply(tensor)\n\n\ndef _gather(tensor):\n    return _GatherFromParallelRegion.apply(tensor)\n\n\nclass ColumnParallelLinear(nn.Module):\n    def __init__(self, in_features, out_features, bias, master_weight):\n        super().__init__()\n        self.in_features = in_features\n        self.out_features = out_features\n        self.use_bias = bool(bias)\n\n        self.world_size = _world_size()\n        self.rank = _rank()\n\n        local_out = out_features // self.world_size\n        weight_shard = _shard(master_weight, 0, self.world_size, self.rank)\n        self.weight = nn.Parameter(weight_shard.detach().clone())\n\n        if self.use_bias:\n            self.bias = nn.Parameter(torch.zeros(\n                local_out, dtype=master_weight.dtype,\n                device=master_weight.device))\n        else:\n            self.register_parameter('bias', None)\n\n    def forward(self, input):\n        output = F.linear(input, self.weight, self.bias)\n        output = _gather(output)\n        return output\n\n\nclass RowParallelLinear(nn.Module):\n    def __init__(self, in_features, out_features, bias, master_weight):\n        super().__init__()\n        self.in_features = in_features\n        self.out_features = out_features\n        self.use_bias = bool(bias)\n\n        self.world_size = _world_size()\n        self.rank = _rank()\n\n        weight_shard = _shard(master_weight, 1, self.world_size, self.rank)\n        self.weight = nn.Parameter(weight_shard.detach().clone())\n\n        if self.use_bias:\n            self.bias = nn.Parameter(torch.zeros(\n                out_features, dtype=master_weight.dtype,\n                device=master_weight.device))\n        else:\n            self.register_parameter('bias', None)\n\n    def forward(self, input):\n        output = F.linear(input, self.weight)\n        output = _reduce(output)\n        if self.use_bias:\n            output = output + self.bias\n        return output\nPYEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/test_parallel.py << 'PYEOF'\nimport os\nimport sys\nimport traceback\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torch.distributed as dist\nimport torch.multiprocessing as mp\n\nsys.path.insert(0, '/app')\nimport parallel_linear as pl\n\n\ndef worker(rank, world_size, in_f, out_f, port):\n    os.environ['MASTER_ADDR'] = '127.0.0.1'\n    os.environ['MASTER_PORT'] = str(port)\n    checks = []\n\n    def check(name, cond):\n        checks.append((name, bool(cond)))\n\n    try:\n        dist.init_process_group('gloo', rank=rank, world_size=world_size)\n    except Exception:\n        traceback.print_exc()\n        return\n\n    try:\n        torch.manual_seed(0)\n        master_weight = torch.randn(out_f, in_f)\n        x = torch.randn(6, in_f)\n\n        ref_w = nn.Parameter(master_weight.clone())\n        ref_b = nn.Parameter(torch.zeros(out_f))\n        ref_w.zero_grad()\n        ref_b.zero_grad()\n        ref_out = F.linear(x, ref_w, ref_b)\n        (ref_out ** 2).sum().backward()\n\n        col = pl.ColumnParallelLinear(in_f, out_f, True, master_weight)\n        lo = out_f // world_size\n        check('col.weight.shape', tuple(col.weight.shape) == (lo, in_f))\n        check('col.weight.shard', torch.allclose(col.weight.data, master_weight[rank*lo:(rank+1)*lo, :]))\n        check('col.bias.shape', tuple(col.bias.shape) == (lo,))\n        check('col.bias.zero', bool(torch.all(col.bias.data == 0)))\n\n        out_col = col(x)\n        check('col.out.shape', tuple(out_col.shape) == (6, out_f))\n        check('col.out.value', torch.allclose(out_col, ref_out, atol=1e-5))\n\n        col.zero_grad()\n        (out_col ** 2).sum().backward()\n        check('col.weight.grad', torch.allclose(col.weight.grad, ref_w.grad[rank*lo:(rank+1)*lo, :], atol=1e-5))\n        check('col.bias.grad', torch.allclose(col.bias.grad, ref_b.grad[rank*lo:(rank+1)*lo], atol=1e-5))\n\n        col_nb = pl.ColumnParallelLinear(in_f, out_f, False, master_weight)\n        check('col_nb.bias_none', col_nb.bias is None)\n\n        row = pl.RowParallelLinear(in_f, out_f, True, master_weight)\n        li = in_f // world_size\n        check('row.weight.shape', tuple(row.weight.shape) == (out_f, li))\n        check('row.weight.shard', torch.allclose(row.weight.data, master_weight[:, rank*li:(rank+1)*li]))\n        check('row.bias.shape', tuple(row.bias.shape) == (out_f,))\n        check('row.bias.zero', bool(torch.all(row.bias.data == 0)))\n\n        x_shard = x[:, rank*li:(rank+1)*li]\n        out_row = row(x_shard)\n        check('row.out.shape', tuple(out_row.shape) == (6, out_f))\n        check('row.out.value', torch.allclose(out_row, ref_out, atol=1e-5))\n\n        row.zero_grad()\n        (out_row ** 2).sum().backward()\n        check('row.weight.grad', torch.allclose(row.weight.grad, ref_w.grad[:, rank*li:(rank+1)*li], atol=1e-5))\n        check('row.bias.grad', torch.allclose(row.bias.grad, ref_b.grad, atol=1e-5))\n\n        row_nb = pl.RowParallelLinear(in_f, out_f, False, master_weight)\n        check('row_nb.bias_none', row_nb.bias is None)\n\n        ok = torch.tensor([1.0 if all(c for _, c in checks) else 0.0])\n        dist.all_reduce(ok, op=dist.ReduceOp.MIN)\n        if rank == 0:\n            bad = [n for n, c in checks if not c]\n            status = 'PASS' if ok.item() > 0.5 else 'FAIL'\n            print('[ws=%d] %s  failed=%s' % (world_size, status, bad), flush=True)\n    except Exception:\n        traceback.print_exc()\n        if rank == 0:\n            print('[ws=%d] EXCEPTION' % world_size, flush=True)\n    finally:\n        dist.destroy_process_group()\n\n\ndef main():\n    for ws in (1, 2, 4):\n        try:\n            mp.spawn(worker, args=(ws, 32, 48, 29520 + ws), nprocs=ws, join=True)\n        except Exception:\n            traceback.print_exc()\n            print('[ws=%d] SPAWN ERROR' % ws, flush=True)\n\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"] min_timeout_sec: 1.0 m