Sending keys: ["python3 << 'EOF'\nimport re\nd=open('image.ppm','rb').read().decode()\nrest=d[d.index('255')+3:]\nnums=rest.split()\npx=[tuple(map(int,nums[i*3:i*3+3])) for i in range(800*600)]\n# OLS fit sky R,G = a0 + a1*u + a2*y + a3*u*y , u=(x-400)^2  (sample every 3rd for speed)\nimport random\npts=[]\nfor y in range(0,300):\n    for x in range(0,800,3):\n        p=px[y*800+x]\n        if p[2]==255:\n            pts.append((x,y,p))\nprint('sky sample pts',len(pts))\ndef fit(vals_idx):\n    # build normal eqs 4x4\n    X=[[1.0,((x-400.0)**2),y,((x-400.0)**2)*y] for x,y,p in pts]\n    v=[p[vals_idx] for x,y,p in pts]\n    import itertools\n    n=4\n    A=[[0.0]*n for _ in range(n)]\n    b=[0.0]*n\n    for row,val in zip(X,v):\n        for i in range(n):\n            b[i]+=row[i]*val\n            for j in range(n):\n                A[i][j]+=row[i]*row[j]\n    # gaussian elim\n    M=[A[i]+[b[i]] for i in range(n)]\n    for i in range(n):\n        p=M[i][i]\n        for j in range(i,n+1): M[i][j]/=p\n        for k in range(n):\n            if k!=i:\n                f=M[k][i]\n                for j in range(i,n+1): M[k][j]-=f*M[i][j]\n    return [M[i][n] for i in range(n)]\nfor name,idx in [('R',0),('G',1)]:\n    c=fit(idx)\n    # max abs error\n    mx=0\n    for x,y,p in pts:\n        u=(x-400.0)**2\n        pred=c[0]+c[1]*u+c[2]*y+c[3]*u*y\n        mx=max(mx,abs(pred-p[idx]))\n    print(name,'coefs=[%f,%f,%f,%f]'%(c[0],c[1],c[2],c[3]),'maxerr=%.3f'%mx)\nEOF\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
