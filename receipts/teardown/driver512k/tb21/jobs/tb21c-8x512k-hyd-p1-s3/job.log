Sending keys: ["cat > /app/align.py << 'PYEOF'\ndef parse_fasta(fn):\n    seqs={}; name=None; buf=[]\n    for line in open(fn):\n        line=line.rstrip('\\n')\n        if line.startswith('>'):\n            if name is not None: seqs[name]=''.join(buf)\n            name=line[1:].strip(); buf=[]\n        else: buf.append(line.strip())\n    if name is not None: seqs[name]=''.join(buf)\n    return seqs\nS=parse_fasta('/app/sequences.fasta')\ninp=S['input']; out=S['output']; egfp=S['egfp']; flag=S['flag']; snap=S['snap']\n\ndef best_align(part, out, W=25):\n    # find best exact W-mer anchor, extend both ways, return (part_start, out_start, match_len)\n    cands=[]\n    for i in range(0, len(part)-W+1):\n        m=out.find(part[i:i+W])\n        if m>=0:\n            l=i; r=m\n            while l>0 and r>0 and part[l-1]==out[r-1]:\n                l-=1; r-=1\n            while l+W<len(part) and r+W<len(out) and part[l+W]==out[r+W]:\n                l+=1; r+=1\n            # recompute match length by extending from anchor region\n            ml = W\n            while l>0 and r>0 and part[l-1]==out[r-1]:\n                l-=1; r-=1; ml+=1\n            while l+ml<len(part) and r+ml<len(out) and part[l+ml]==out[r+ml]:\n                ml+=1\n            cands.append((ml,l,r))\n    cands.sort(reverse=True)\n    return cands[0] if cands else (0,0,0)\n\n# egfp\neL=0\nwhile eL+1<=len(egfp) and out[210+eL]==egfp[eL]:\n    eL+=1\nprint('egfp match len from out[210]:', eL, ' egfp[0] -> out[210], egfp[0:%d]->out[210:%d]'%(eL,210+eL))\nJ2=210+eL  # flag-part starts here\nprint('J2 (egfp|flag) at out', J2)\n\n# flag: best align within out[J2:J2+200]\nfl=best_align(flag, out, 25)\nprint('flag best: match_len=%d part_start=%d out_start=%d'%(fl))\nprint('   flag[%d:%d] -> out[%d:%d]'%(fl[1],fl[1]+fl[0],fl[2],fl[2]+fl[0]))\nJ3=fl[2]+fl[0]  # flag-part ends here in out\nprint('J3 (flag|snap) at out', J3)\n\n# snap: best align, should end at out[1554]\nsl=best_align(snap, out, 25)\nprint('snap best: match_len=%d part_start=%d out_start=%d'%(sl))\nprint('   snap[%d:%d] -> out[%d:%d]'%(sl[1],sl[1]+sl[0],sl[2],sl[2]+sl[0]))\nprint('   snap end in out:', sl[2]+sl[0], '(expected 1554)')\n\n# Now define fragments & overhangs\nO1=out[210:214]     # backbone->egfp\nO2=out[J2:J2+4]     # egfp->flag\nO3=out[J3:J3+4]     # flag->snap\nO4=out[1554:1558]   # snap->backbone\nprint('\\nOVERHANGS (first4 of RIGHT fragment):')\nprint('O1 (backbone->egfp)=',O1,' (egfp[0:4]=',egfp[0:4],')')\nprint('O2 (egfp->flag)=     ',O2)\nprint('O3 (flag->snap)=      ',O3)\nprint('O4 (snap->backbone)=  ',O4)\n\n# flag-part and snap-part contents\nflag_part=out[J2:J3]; snap_part=out[J3:1554]\nprint('\\nflag_part len',len(flag_part),'=',flag_part[:15],'...')\nprint('snap_part len',len(snap_part),'=',snap_part[:15],'...')\nprint('snap_part[-10:]=',snap_part[-10:])\nPYEOF\npython3 /app/align.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
