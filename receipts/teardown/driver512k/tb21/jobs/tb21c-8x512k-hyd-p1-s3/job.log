Sending keys: ["cat > /app/struct.py << 'PYEOF'\nimport re\n\ndef parse_fasta(fn):\n    seqs={}; name=None; buf=[]\n    for line in open(fn):\n        line=line.rstrip('\\n')\n        if line.startswith('>'):\n            if name is not None: seqs[name]=''.join(buf)\n            name=line[1:].strip(); buf=[]\n        else: buf.append(line.strip())\n    if name is not None: seqs[name]=''.join(buf)\n    return seqs\nS=parse_fasta('/app/sequences.fasta')\ninp=S['input']; out=S['output']; egfp=S['egfp']; flag=S['flag']; snap=S['snap']\n\n# egfp start in output\nse=out.find(egfp[:20]); print('egfp starts at',se)\n# find snap end: locate a 30-nt chunk near end of snap\nfor L in range(min(60,len(snap)),0,-1):\n    idx=out.find(snap[-L:])\n    if idx>=0:\n        print('snap tail len',L,'ends at out index',idx+L); break\nE=idx+L\nprint('insert region out[%d:%d] len %d'%(se,E,E-se))\nprint('backbone len = %d (210-ish + %d)'%(se+(len(out)-E),len(out)-E))\n\n# Now reconstruct insert and compare to egfp+flag+snap with deletions\nins=out[se:E]\nprint('\\nINSERT length:',len(ins))\nprint('egfp+flag+snap length:',len(egfp)+len(flag)+len(snap))\n\n# Show junctions in insert\nprint('\\ninsert[0:40]:',ins[:40])\nprint('egfp[:40]:   ',egfp[:40])\nprint('egfp end:',egfp[-20:])\nprint('flag start:',flag[:20])\nprint('flag end:',flag[-20:])\nprint('snap start:',snap[:20])\nprint('snap end:',snap[-20:])\n\n# locate flag in insert\ndef find_all(s,h):\n    r=[]; i=h.find(s)\n    while i>=0:\n        r.append(i); i=h.find(s,i+1)\n    return r\nprint('\\nflag 20-mer starts in insert:', find_all(flag[:20],ins))\nprint('flag 20-mer ends in insert:', find_all(flag[-20:],ins))\nprint('snap 20-mer starts in insert:', find_all(snap[:20],ins))\nprint('snap 20-mer ends in insert:', find_all(snap[-20:],ins))\nPYEOF\npython3 /app/struct.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
