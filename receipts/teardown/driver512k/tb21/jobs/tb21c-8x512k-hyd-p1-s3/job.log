Sending keys: ['cd /app && cat > /app/convert_masks.py << \'PYEOF\'\n#!/usr/bin/env python3\n"""Refine all cell masks (rectangles and polylines) into polylines using MobileSAM.\n\nReads an RGB image + a metadata CSV (one mask per cell). Uses MobileSAM to refine\nevery mask and guarantees: (a) each mask is a single contiguous polygon and (b) no\ntwo masks overlap. Writes a CSV matching the input structure with updated\nxmin/xmax/ymin/ymax, coords_x and coords_y (and type=\'polyline\').\n"""\nimport argparse\nimport os\nimport warnings\n\n# Cap intra-op threads BEFORE importing torch: on some AVX-512 CPUs very high thread\n# counts make oneDNN extremely slow / unstable. 8 is a robust default.\n_NPROC = os.cpu_count() or 8\n_T = max(1, min(8, _NPROC))\nos.environ.setdefault("OMP_NUM_THREADS", str(_T))\nos.environ.setdefault("MKL_NUM_THREADS", str(_T))\nos.environ.setdefault("OMP_DYNAMIC", "false")\n\nwarnings.filterwarnings("ignore")\n\nimport numpy as np\nimport pandas as pd\nimport cv2\nimport torch\nfrom tqdm import tqdm\n\n\n# ---------------------------------------------------------------------------- #\n# Parsing / I/O helpers\n# ---------------------------------------------------------------------------- #\ndef parse_coords(s):\n    """Parse a comma-separated coordinate string into a float64 1-D ndarray."""\n    if s is None:\n        return np.array([], dtype=np.float64)\n    s = str(s).strip()\n    if s == "" or s.lower() == "nan":\n        return np.array([], dtype=np.float64)\n    parts = [p for p in s.split(",") if p.strip() != ""]\n    if not parts:\n        return np.array([], dtype=np.float64)\n    return np.array([float(p) for p in parts], dtype=np.float64)\n\n\ndef load_image_rgb(path):\n    img = cv2.imread(path, cv2.IMREAD_COLOR)\n    if img is None:\n        from PIL import Image\n        img = np.asarray(Image.open(path).convert("RGB"))\n        return np.ascontiguousarray(img)\n    return cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n\n\ndef csv_has_index_column(path):\n    """True if the CSV\'s first header cell is empty (a bare row-index column)."""\n    with open(path, "r") as f:\n        line = f.readline()\n    if not line:\n        return False\n    first = line.split(",")[0].strip().strip(\'"\').strip()\n    return first == ""\n\n\ndef shoelace_centroid(pts):\n    """Centroid of a (possibly open) simple polygon. Returns None if degenerate."""\n    if pts is None or len(pts) < 3:\n        return None\n    x = pts[:, 0]\n    y = pts[:, 1]\n    x2 = np.roll(x, -1)\n    y2 = np.roll(y, -1)\n    cross = x * y2 - x2 * y\n    A = 0.5 * float(np.sum(cross))\n    if abs(A) < 1e-6:\n        return None\n    cx = float(np.sum((x + x2) * cross)) / (6.0 * A)\n    cy = float(np.sum((y + y2) * cross)) / (6.0 * A)\n    return cx, cy\n\n\n# ---------------------------------------------------------------------------- #\n# Mask post-processing helpers\n# ---------------------------------------------------------------------------- #\ndef largest_connected_component(mask):\n    """Return the single largest connected component of a binary mask."""\n    m = (mask > 0).astype(np.uint8)\n    n, labels, stats, _ = cv2.connectedComponentsWithStats(m, connectivity=8)\n    if n <= 1:\n        return mask  # empty\n    areas = stats[1:, cv2.CC_STAT_AREA]\n    best = 1 + int(np.argmax(areas))\n    return (labels == best)\n\n\ndef mask_to_polygon(mask):\n    """Return (xs, ys) integer arrays for the outer boundary of a binary mask."""\n    m8 = (mask > 0).astype(np.uint8) * 255\n    cnts, _ = cv2.findContours(m8, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)\n    if not cnts:\n        return None\n    c = max(cnts, key=cv2.contourArea)\n    if cv2.contourArea(c) < 1:\n        return None\n    peri = cv2.arcLength(c, True)\n    eps = max(1.0, 0.01 * peri)\n    c = cv2.approxPolyDP(c, eps, True)\n    pts = c.reshape(-1, 2)\n    return pts[:, 0].astype(int).tolist(), pts[:, 1].astype(int).tolist()\n\n\ndef polygon_to_mask(xs, ys, H, W):\n    """Fill a polygon into a binary HxW mask."""\n    mm = np.zeros((H, W), dtype=np.uint8)\n    pts = np.stack([xs, ys], axis=1).astype(np.int32)\n    cv2.fillPoly(mm, [pts], 1)\n    return mm > 0\n\n\ndef close_polygon(xs, ys):\n    """Append the first vertex so the polygon is closed (matches input style)."""\n    if len(xs) < 3:\n        return list(xs), list(ys)\n    if xs[0] != xs[-1] or ys[0] != ys[-1]:\n        xs = list(xs) + [xs[0]]\n        ys = list(ys) + [ys[0]]\n    return list(xs), list(ys)\n\n\n# ---------------------------------------------------------------------------- #\n# Main\n# ---------------------------------------------------------------------------- #\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument("--weights_path", type=str, required=True)\n    ap.add_argument("--output_path", type=str, required=True)\n    ap.add_argument("--rgb_path", type=str, required=True)\n    ap.add_argument("--csv_path", type=str, required=True)\n    args = ap.parse_args()\n\n    device = "cuda" if torch.cuda.is_available() else "cpu"\n    torch.set_num_threads(_T)\n\n    rgb = load_image_rgb(args.rgb_path)\n    H, W = rgb.shape[:2]\n\n    has_idx = csv_has_index_column(args.csv_path)\n    df = pd.read_csv(args.csv_path, index_col=0) if has_idx else pd.read_csv(args.csv_path)\n    n = len(df)\n\n    from mobile_sam import build_sam_vit_t, SamPredictor\n    model = build_sam_vit_t(checkpoint=args.weights_path)\n    model.to(device)\n    predictor = SamPredictor(model)\n    predictor.set_image(rgb, image_format="RGB")\n\n    # ---- Per-mask MobileSAM refinement ------------------------------------ #\n    raw_masks = []\n    for i in tqdm(range(n), desc="Refining masks with MobileSAM"):\n        row = df.iloc[i]\n        cx_in = parse_coords(row["coords_x"])\n        cy_in = parse_coords(row["coords_y"])\n        bx0 = int(np.clip(float(row["xmin"]), 0, W - 1))\n        by0 = int(np.clip(float(row["ymin"]), 0, H - 1))\n        bx1 = int(np.clip(float(row["xmax"]), 0, W - 1))\n        by1 = int(np.clip(float(row["ymax"]), 0, H - 1))\n        if bx1 < bx0:\n            bx1 = bx0\n        if by1 < by0:\n            by1 = by0\n\n        if len(cx_in) >= 3 and len(cx_in) == len(cy_in):\n            cent = shoelace_centroid(np.stack([cx_in, cy_in], axis=1))\n            px, py = cent if cent is not None else ((bx0 + bx1) / 2.0, (by0 + by1) / 2.0)\n        else:\n            px, py = (bx0 + bx1) / 2.0, (by0 + by1) / 2.0\n        px = float(np.clip(px, bx0, bx1))\n        py = float(np.clip(py, by0, by1))\n\n        pt = np.array([[px, py]], dtype=np.float64)\n        lbl = np.array([1], dtype=np.int64)\n        box = np.array([bx0, by0, bx1, by1], dtype=np.float64)\n\n        masks, _, _ = predictor.predict(\n            point_coords=pt, point_labels=lbl, box=box, multimask_output=False\n        )\n        m = masks[0].astype(bool)\n        raw_masks.append(largest_connected_component(m))\n\n    # ---- Polygonize, then iteratively remove overlap between polygons ----- #\n    polys = [mask_to_polygon(m) for m in raw_masks]\n    order = list(np.argsort([-int(m.sum()) for m in raw_masks], kind="stable"))\n\n    for _ in range(30):\n        fills = [None if p is None else polygon_to_mask(p[0], p[1], H, W) for p in polys]\n        sumimg = np.zeros((H, W), dtype=np.int32)\n        for f in fills:\n            if f is not None:\n                sumimg += f.astype(np.int32)\n        if sumimg.max() <= 1:\n            break\n        claimed = np.zeros((H, W), dtype=bool)\n        newfills = [None] * n\n        for i in order:\n            f = fills[i]\n            if f is None:\n                continue\n            a = f & ~claimed\n            newfills[i] = a\n            claimed |= a\n        for i in range(n):\n            polys[i] = mask_to_polygon(newfills[i]) if (newfills[i] is not None and newfills[i].sum() > 0) else None\n\n    # ---- Build output columns --------------------------------------------- #\n    out_xmin, out_ymin, out_xmax, out_ymax, out_cx, out_cy = [], [], [], [], [], []\n    for i in range(n):\n        p = polys[i]\n        if p is None:\n            xs = parse_coords(df.iloc[i]["coords_x"]).astype(int).tolist()\n            ys = parse_coords(df.iloc[i]["coords_y"]).astype(int).tolist()\n        else:\n            xs, ys = p\n        xs = [int(v) for v in xs]\n        ys = [int(v) for v in ys]\n        if xs and ys:\n            out_xmin.append(min(xs)); out_xmax.append(max(xs))\n            out_ymin.append(min(ys)); out_ymax.append(max(ys))\n        else:\n            out_xmin.append(0); out_xmax.append(0); out_ymin.append(0); out_ymax.append(0)\n        xsc, ysc = close_polygon(xs, ys)\n        out_cx.append(xsc); out_cy.append(ysc)\n\n    df["xmin"] = out_xmin\n    df["ymin"] = out_ymin\n    df["xmax"] = out_xmax\n    df["ymax"] = out_ymax\n    df["type"] = "polyline"\n    df["coords_x"] = [",".join(str(v) for v in xs) for xs in out_cx]\n    df["coords_y"] = [",".join(str(v) for v in ys) for ys in out_cy]\n\n    out_dir = os.path.dirname(os.path.abspath(args.output_path))\n    if out_dir:\n        os.makedirs(out_dir, exist_ok=True)\n    if has_idx:\n        df.to_csv(args.output_path, index_label="")\n    else:\n        df.to_csv(args.output_path, index=False)\n    print("Wrote %d masks to %s" % (n, args.output_path))\n\n\nif __name__ == "__main__":\n    main()\nPYEOF\necho "written"; python3 -c "import ast; ast.parse(open(\'/app/convert_masks.py\').read()); print(\'syntax OK\')"\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
