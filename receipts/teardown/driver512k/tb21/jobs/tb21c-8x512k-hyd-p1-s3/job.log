Sending keys: ["cd /app && cat > /tmp/exp2.py << 'PYEOF'\nimport time, copy, mujoco, numpy as np\nm_ref = mujoco.MjModel.from_xml_path('model_ref.xml')\nFULL = mujoco.mjtState.mjSTATE_FULLPHYSICS\ndef simulate(model, seed, total=2.0):\n    data = mujoco.MjData(model)\n    nstep = int(total/model.opt.timestep)\n    rng = np.random.default_rng(seed)\n    data.qpos += rng.normal(0,0.01,size=data.qpos.shape)\n    mujoco.mj_forward(model,data)\n    for _ in range(nstep):\n        mujoco.mj_step(model,data)\n    st = np.zeros(mujoco.mj_stateSize(model,FULL))\n    mujoco.mj_getState(model,data,st,FULL)\n    return st\ndef timing(model, seed, total=2.0):\n    data = mujoco.MjData(model)\n    nstep = int(total/model.opt.timestep)\n    rng = np.random.default_rng(seed)\n    data.qpos += rng.normal(0,0.01,size=data.qpos.shape)\n    mujoco.mj_forward(model,data)\n    t0=time.perf_counter()\n    for _ in range(nstep):\n        mujoco.mj_step(model,data)\n    return time.perf_counter()-t0\nfor seed in [1,100,500,999]:\n    data = mujoco.MjData(m_ref); rng=np.random.default_rng(seed)\n    data.qpos += rng.normal(0,0.01,size=data.qpos.shape); mujoco.mj_forward(m_ref,data)\n    mx=0\n    for _ in range(1000):\n        mujoco.mj_step(m_ref,data); mx=max(mx,data.ncon)\n    print('seed',seed,'max ncon over 1000 steps', mx)\nref_states = {s: simulate(m_ref, s) for s in [1,100,500,999]}\nvariants = {\n  'iters100': dict(),\n  'iters50': dict(iterations=50),\n  'iters20': dict(iterations=20),\n  'iters10': dict(iterations=10),\n  'iters5':  dict(iterations=5),\n  'iters3':  dict(iterations=3),\n  'tol1e-6': dict(tolerance=1e-6),\n  'tol1e-4': dict(tolerance=1e-4),\n  'ls20':    dict(ls_iterations=20),\n  'ls5':     dict(ls_iterations=5),\n  'pgs':     dict(solver=0),\n  'pgs10':   dict(solver=0, iterations=10),\n}\nseeds=[1,100,500,999]\nfor name, kv in variants.items():\n    m = copy.deepcopy(m_ref)\n    for k,v in kv.items():\n        setattr(m.opt, k, v)\n    times=[]; diffs=[]\n    for s in seeds:\n        t=timing(m,s); times.append(t)\n        st=simulate(m,s); diffs.append(np.max(np.abs(st-ref_states[s])))\n    print(f'{name:10s} t={np.mean(times):.4f}  maxdiff={np.max(diffs):.3e}')\nprint('baseline ref t per seed:', [round(timing(m_ref,s),4) for s in seeds])\nPYEOF\npython3 /tmp/exp2.py\n"] min_timeout_sec: 25.0 max_timeout_sec: 180.0
