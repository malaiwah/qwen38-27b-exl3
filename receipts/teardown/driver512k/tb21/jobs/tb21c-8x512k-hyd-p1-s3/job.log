Sending keys: ["python3 << 'EOF'\nimport math\n# sky data points (x,y)->(R,G)\npts=[(400,0,146,190),(0,0,159,197),(799,0,159,197),(400,200,171,205),(0,250,185,213),(799,250,185,213),\n(400,100,156,196),(400,50,151,193),(200,0,151,193),(600,0,151,193),(0,150,173,206),(799,150,173,206)]\n# try R = a + b*sqrt((x-400)^2+(y-cy)^2)\nimport itertools\n# search cy and fit b via least squares for R and G\nbest=None\ndef fit(cy,chan):\n    # linear model R=a+b*d, minimize over a,b\n    d=[math.hypot(x-400,y-cy) for x,y,_,_ in pts]\n    vals=[(chan==0 and p[2] or p[3]) for p in pts]\n    n=len(pts)\n    sdd=sum(v*v for v in vals); sdy=sum(v for v in vals); sxd=sum(dd for dd in d); sx2=sum(dd*dd for dd in d)\n    denom=n*sx2-sxd*sxd\n    b=(n*sdd-sxd*sdy)/denom; a=(sdy-b*sxd)/n\n    err=sum((a+b*dd-v)**2 for dd,v in zip(d,vals))\n    return a,b,err\nfor cy in [0,100,150,200,250,300]:\n    for chan in [0,1]:\n        a,b,err=fit(cy,chan)\n        print('cy=%d chan=%d R=%.3f b=%.5f err=%.2f'%(cy,chan,a,b,err))\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
