Sending keys: ["cd /app && cat > /tmp/exp3.py << 'PYEOF'\nimport time, copy, mujoco, numpy as np\nm_ref = mujoco.MjModel.from_xml_path('model_ref.xml')\nFULL = mujoco.mjtState.mjSTATE_FULLPHYSICS\ndef simulate(model, seed, total=2.0):\n    data = mujoco.MjData(model)\n    nstep = int(total/model.opt.timestep)\n    rng = np.random.default_rng(seed)\n    data.qpos += rng.normal(0,0.01,size=data.qpos.shape)\n    mujoco.mj_forward(model,data)\n    for _ in range(nstep):\n        mujoco.mj_step(model,data)\n    st = np.zeros(mujoco.mj_stateSize(model,FULL))\n    mujoco.mj_getState(model,data,st,FULL)\n    return st, nstep\ndef timing(model, seed, total=2.0):\n    data = mujoco.MjData(model)\n    nstep = int(total/model.opt.timestep)\n    rng = np.random.default_rng(seed)\n    data.qpos += rng.normal(0,0.01,size=data.qpos.shape)\n    mujoco.mj_forward(model,data)\n    t0=time.perf_counter()\n    for _ in range(nstep):\n        mujoco.mj_step(model,data)\n    return time.perf_counter()-t0\nseeds=[1,100,500,999]\nref_states={s:simulate(m_ref,s)[0] for s in seeds}\nref_t=np.mean([timing(m_ref,s) for s in seeds])\nprint('ref avg t', round(ref_t,4), 'nstep', int(2.0/m_ref.opt.timestep))\n# INTEGRATOR: 0 Euler, 1 RK4, 4 semi-implicit euler?\nfor intg in [0,1]:\n  for dt in [0.002,0.004,0.005,0.008,0.01,0.02]:\n    m=copy.deepcopy(m_ref); m.opt.timestep=dt; m.opt.integrator=intg\n    ts=[];ds=[];ns=None\n    for s in seeds:\n        ts.append(timing(m,s)); st,ns=simulate(m,s); ds.append(np.max(np.abs(st-ref_states[s])))\n    ok='OK' if max(ds)<=1e-5 else 'BAD'\n    print(f'intg={intg} dt={dt} nstep={ns} t={np.mean(ts):.4f} ({np.mean(ts)/ref_t*100:.0f}%) maxdiff={max(ds):.2e} {ok}')\nPYEOF\npython3 /tmp/exp3.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
