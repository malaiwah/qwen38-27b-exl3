Sending keys: ["cd /app && cat > /tmp/validate.py << 'PYEOF'\nimport warnings; warnings.filterwarnings('ignore')\nimport numpy as np, pandas as pd, cv2\n\ndef parse(s):\n    if not isinstance(s,str) or s.strip()=='' : return np.array([],dtype=np.float64)\n    p=[x for x in s.split(',') if x.strip()!='']\n    return np.array([float(x) for x in p])\n\nin_df = pd.read_csv('/app/demo_metadata.csv')\nout_df = pd.read_csv('/tmp/out.csv')\nprint('input columns :', list(in_df.columns))\nprint('output columns:', list(out_df.columns))\nprint('columns match :', list(in_df.columns)==list(out_df.columns))\nprint('rows in/out   :', len(in_df), len(out_df))\nprint('all type=polyline:', (out_df['type']=='polyline').all())\nprint('type value_counts:'); print(out_df['type'].value_counts())\n\nimg = cv2.imread('/app/demo_rgb.png'); H,W = img.shape[:2]\nmask_sum = np.zeros((H,W), dtype=np.int32)\nbad_bbox=0; bad_contig=0; empty=0; vcounts=[]\nfor i,row in out_df.iterrows():\n    xs=parse(row['coords_x']); ys=parse(row['coords_y'])\n    vcounts.append(len(xs))\n    if len(xs)==0 or len(ys)==0:\n        empty+=1; continue\n    if not (xs.max()==row['xmax'] or abs(xs.max()-row['xmax'])<=1):\n        bad_bbox+=1\n    m=np.zeros((H,W),dtype=np.uint8)\n    pts=np.stack([xs,ys],1).astype(np.int32)\n    cv2.fillPoly(m,[pts],1)\n    if m.sum()==0:\n        empty+=1; continue\n    # bbox check against filled mask\n    yy,xx=np.where(m>0)\n    if xx.min()!=row['xmin'] or xx.max()!=row['xmax'] or yy.min()!=row['ymin'] or yy.max()!=row['ymax']:\n        bad_bbox+=1\n    n,lab,stats,_=cv2.connectedComponentsWithStats(m,8)\n    if n-1 != 1:\n        bad_contig+=1\n    mask_sum += (m>0).astype(np.int32)\n\nprint('empty masks     :', empty)\nprint('bbox mismatch   :', bad_bbox)\nprint('non-contiguous  :', bad_contig)\nprint('MAX overlap     :', int(mask_sum.max()))\nprint('pixels overlapped:', int((mask_sum>1).sum()))\nprint('vertex counts : min/med/max =', min(vcounts), int(np.median(vcounts)), max(vcounts))\nprint('num masks with <=4 vertices (rect-like):', sum(1 for v in vcounts if v<=4))\nprint('num masks with >4 vertices (true polyline):', sum(1 for v in vcounts if v>4))\nPYEOF\npython3 /tmp/validate.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
