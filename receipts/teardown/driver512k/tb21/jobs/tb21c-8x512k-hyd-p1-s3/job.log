Sending keys: ['cd /app && cat > /app/convert_masks.py << \'PYEOF\'\n#!/usr/bin/env python3\n"""Refine all cell masks (rectangles and polylines) into polylines using MobileSAM.\n\nReads an RGB image + a metadata CSV (one mask per cell), uses MobileSAM to refine\nevery mask, guarantees (a) each mask is a single contiguous polygon, and (b) no\ntwo masks overlap. Writes a CSV matching the input (updated xmin/xmax/ymin/ymax,\ncoords_x, coords_y, type).\n"""\nimport argparse\nimport os\nimport sys\nimport warnings\n\n# Cap intra-op threads BEFORE importing torch: on some AVX-512 CPUs, high thread\n# counts make oneDNN extremely slow (and can be unstable). 8 is a robust default.\n_NPROC = os.cpu_count() or 8\n_T = min(8, _NPROC)\nos.environ.setdefault("OMP_NUM_THREADS", str(_T))\nos.environ.setdefault("MKL_NUM_THREADS", str(_T))\nos.environ.setdefault("OMP_DYNAMIC", "false")\n\nwarnings.filterwarnings("ignore")\n\nimport numpy as np\nimport pandas as pd\nimport cv2\nimport torch\nfrom tqdm import tqdm\n\n\n# ---------------------------------------------------------------------------- #\n# Parsing / I/O helpers\n# ---------------------------------------------------------------------------- #\ndef parse_coords(s):\n    """Parse a comma-separated coordinate string into a float64 1-D ndarray."""\n    if s is None:\n        return np.array([], dtype=np.float64)\n    s = str(s).strip()\n    if s == "" or s.lower() == "nan":\n        return np.array([], dtype=np.float64)\n    parts = [p for p in s.split(",") if p.strip() != ""]\n    if not parts:\n        return np.array([], dtype=np.float64)\n    return np.array([float(p) for p in parts], dtype=np.float64)\n\n\ndef load_image_rgb(path):\n    img = cv2.imread(path, cv2.IMREAD_COLOR)\n    if img is None:\n        from PIL import Image\n        img = np.asarray(Image.open(path).convert("RGB"))\n        return np.ascontiguousarray(img)\n    return cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n\n\ndef shoelace_centroid(pts):\n    """Centroid of a (possibly open) simple polygon. Returns None if degenerate."""\n    if pts is None or len(pts) < 3:\n        return None\n    x = pts[:, 0]\n    y = pts[:, 1]\n    x2 = np.roll(x, -1)\n    y2 = np.roll(y, -1)\n    cross = x * y2 - x2 * y\n    A = 0.5 * float(np.sum(cross))\n    if abs(A) < 1e-6:\n        return None\n    cx = float(np.sum((x + x2) * cross)) / (6.0 * A)\n    cy = float(np.sum((y + y2) * cross)) / (6.0 * A)\n    return cx, cy\n\n\n# ---------------------------------------------------------------------------- #\n# Mask post-processing helpers\n# ---------------------------------------------------------------------------- #\ndef largest_connected_component(mask):\n    """Return the single largest connected component of a binary mask."""\n    m = (mask > 0).astype(np.uint8)\n    n, labels, stats, _ = cv2.connectedComponentsWithStats(m, connectivity=8)\n    if n <= 1:\n        return mask  # empty\n    areas = stats[1:, cv2.CC_STAT_AREA]\n    best = 1 + int(np.argmax(areas))\n    return labels == best\n\n\ndef mask_to_polygon(mask):\n    """Return (xs, ys) integer lists describing the outer boundary of the mask."""\n    m8 = (mask > 0).astype(np.uint8) * 255\n    cnts, _ = cv2.findContours(m8, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)\n    if not cnts:\n        return None\n    c = max(cnts, key=cv2.contourArea)\n    if cv2.contourArea(c) < 1:\n        return None\n    peri = cv2.arcLength(c, True)\n    eps = max(1.0, 0.01 * peri)\n    c = cv2.approxPolyDP(c, eps, True)\n    pts = c.reshape(-1, 2)\n    return pts[:, 0].astype(int), pts[:, 1].astype(int)\n\n\ndef close_polygon(xs, ys):\n    """Append the first vertex so the polygon is closed (matches input style)."""\n    if len(xs) < 3:\n        return xs, ys\n    if xs[0] != xs[-1] or ys[0] != ys[-1]:\n        xs = list(xs) + [xs[0]]\n        ys = list(ys) + [ys[0]]\n    return list(xs), list(ys)\n\n\n# ---------------------------------------------------------------------------- #\n# Main\n# ---------------------------------------------------------------------------- #\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument("--weights_path", type=str, required=True)\n    ap.add_argument("--output_path", type=str, required=True)\n    ap.add_argument("--rgb_path", type=str, required=True)\n    ap.add_argument("--csv_path", type=str, required=True)\n    args = ap.parse_args()\n\n    device = "cuda" if torch.cuda.is_available() else "cpu"\n    torch.set_num_threads(max(1, min(8, torch.get_num_threads())))\n\n    rgb = load_image_rgb(args.rgb_path)\n    H, W = rgb.shape[:2]\n\n    from mobile_sam import build_sam_vit_t, SamPredictor\n    model = build_sam_vit_t(checkpoint=args.weights_path)\n    model.to(device)\n    predictor = SamPredictor(model)\n    predictor.set_image(rgb, image_format="RGB")\n\n    df = pd.read_csv(args.csv_path)\n    n = len(df)\n\n    # ---- Per-mask MobileSAM refinement ------------------------------------ #\n    raw_masks = []\n    for i in tqdm(range(n), desc="Refining masks with MobileSAM"):\n        row = df.iloc[i]\n        cx_in = parse_coords(row["coords_x"])\n        cy_in = parse_coords(row["coords_y"])\n        xmin = float(row["xmin"]); xmax = float(row["xmax"])\n        ymin = float(row["ymin"]); ymax = float(row["ymax"])\n\n        # Bounding box (clamped to image) used as the localizing prompt.\n        bx0 = int(np.clip(xmin, 0, W - 1)); by0 = int(np.clip(ymin, 0, H - 1))\n        bx1 = int(np.clip(xmax, 0, W - 1)); by1 = int(np.clip(ymax, 0, H - 1))\n        if bx1 < bx0:\n            bx1 = bx0\n        if by1 < by0:\n            by1 = by0\n\n        # Positive point: centroid of the input polygon, else bbox centre.\n        if len(cx_in) >= 3 and len(cx_in) == len(cy_in):\n            pts = np.stack([cx_in, cy_in], axis=1)\n            cent = shoelace_centroid(pts)\n            if cent is not None:\n                px, py = cent\n            else:\n                px, py = (bx0 + bx1) / 2.0, (by0 + by1) / 2.0\n        else:\n            px, py = (bx0 + bx1) / 2.0, (by0 + by1) / 2.0\n        px = float(np.clip(px, bx0, bx1)); py = float(np.clip(py, by0, by1))\n\n        pt = np.array([[px, py]], dtype=np.float64)\n        lbl = np.array([1], dtype=np.int64)\n        box = np.array([bx0, by0, bx1, by1], dtype=np.float64)\n\n        masks, iou, low = predictor.predict(\n            point_coords=pt, point_labels=lbl, box=box, multimask_output=False\n        )\n        m = masks[0].astype(bool)\n        # Initial contiguity: single component.\n        m = largest_connected_component(m)\n        raw_masks.append(m)\n\n    # ---- Global overlap resolution (larger mask wins) --------------------- #\n    areas = np.array([int(m.sum()) for m in raw_masks], dtype=np.int64)\n    order = np.argsort(-areas, kind="stable")\n    claimed = np.zeros((H, W), dtype=bool)\n    final_masks = [None] * n\n    for i in order:\n        m = raw_masks[i].copy()\n        m &= ~claimed\n        if m.sum() == 0:\n            # Fallback: keep the original (un-overlap-removed) component.\n            m = raw_masks[i].copy()\n            m &= ~claimed\n            if m.sum() == 0:\n                m = raw_masks[i].copy()\n        m = largest_connected_component(m)\n        final_masks[i] = m\n        claimed |= m\n\n    # ---- Polygon + bbox extraction ---------------------------------------- #\n    out_xmin, out_ymin, out_xmax, out_ymax = [], [], [], []\n    out_cx, out_cy = [], []\n    for i in range(n):\n        m = final_masks[i]\n        if m.sum() == 0:\n            # Should not happen; fall back to the original mask geometry.\n            xs = parse_coords(df.iloc[i]["coords_x"]).astype(int).tolist()\n            ys = parse_coords(df.iloc[i]["coords_y"]).astype(int).tolist()\n            out_xmin.append(int(df.iloc[i]["xmin"])); out_ymin.append(int(df.iloc[i]["ymin"]))\n            out_xmax.append(int(df.iloc[i]["xmax"]); out_ymax.append(int(df.iloc[i]["ymax"]))\n            xsc, ysc = close_polygon(xs, ys)\n            out_cx.append(xsc); out_cy.append(ysc)\n            continue\n        ys_idx, xs_idx = np.where(m)\n        out_xmin.append(int(xs_idx.min())); out_xmax.append(int(xs_idx.max()))\n        out_ymin.append(int(ys_idx.min())); out_ymax.append(int(ys_idx.max()))\n        poly = mask_to_polygon(m)\n        if poly is None:\n            xs = xs_idx.tolist(); ys = ys_idx.tolist()\n        else:\n            xs, ys = poly\n        xsc, ysc = close_polygon(xs, ys)\n        out_cx.append(xsc); out_cy.append(ysc)\n\n    # ---- Write output CSV (same columns as input) ------------------------- #\n    df["xmin"] = out_xmin\n    df["ymin"] = out_ymin\n    df["xmax"] = out_xmax\n    df["ymax"] = out_ymax\n    df["type"] = "polyline"\n    df["coords_x"] = [",".join(str(int(v)) for v in xs) for xs in out_cx]\n    df["coords_y"] = [",".join(str(int(v)) for v in ys) for ys in out_cy]\n\n    out_dir = os.path.dirname(os.path.abspath(args.output_path))\n    if out_dir:\n        os.makedirs(out_dir, exist_ok=True)\n    df.to_csv(args.output_path, index_label="")\n    print("Wrote %d masks to %s" % (n, args.output_path))\n\n\nif __name__ == "main":\n    main()\nPYEOF\necho "written"; python3 -c "import ast; ast.parse(open(\'/app/convert_masks.py\').read()); print(\'syntax OK\')"\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
