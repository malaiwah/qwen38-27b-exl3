Sending keys: ["cat > /app/parse3.py << 'PYEOF'\nimport re\n\ndef get(code, line):\n    m = re.search(code+r'(-?\\d+\\.?\\d*)', line)\n    return float(m.group(1)) if m else None\n\nx=y=z=0.0\nmode=None\nsegs0=[]  # text\nsegs1=[]  # box\n\nwith open('/app/text.gcode') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        if line.startswith('M486 S0'): mode=0\n        elif line.startswith('M486 S1'): mode=1\n        elif line.startswith('M486 S-1'): mode=None\n        elif line.startswith('G0') or line.startswith('G1'):\n            nx=get('X',line); ny=get('Y',line); nz=get('Z',line); ne=get('E',line)\n            ox,oy=x,y\n            if nx is not None: x=nx\n            if ny is not None: y=ny\n            if nz is not None: z=nz\n            if ne is not None and ne>0 and (nx is not None or ny is not None):\n                if mode==0: segs0.append((ox,oy,x,y))\n                elif mode==1: segs1.append((ox,oy,x,y))\n\ndef bounds(segs):\n    xs=[s[0] for s in segs]+[s[2] for s in segs]\n    ys=[s[1] for s in segs]+[s[3] for s in segs]\n    return min(xs),min(ys),max(xs),max(ys)\n\nprint('text segs', len(segs0), 'box segs', len(segs1))\nprint('text bounds', [round(v,1) for v in bounds(segs0)])\nprint('box bounds', [round(v,1) for v in bounds(segs1)])\n\n# Render text (mode 0) as ASCII top-down view\nminx,miny,maxx,maxy=bounds(segs0)\ndx=maxx-minx; dy=maxy-miny\nW=150\nH=int(round(W*(dy/dx)*0.5))\ngrid=[[' ']*W for _ in range(H)]\ndef plot(px,py):\n    cx=int((px-minx)/dx*(W-1))\n    cy=int((py-miny)/dy*(H-1))\n    cy=H-1-cy\n    if 0<=cx<W and 0<=cy<H: grid[cy][cx]='#'\nimport math\nfor (x0,y0,x1,y1) in segs0:\n    L=math.hypot(x1-x0,y1-y0)\n    n=max(1,int(L/0.15))\n    for i in range(n+1):\n        t=i/n\n        plot(x0+(x1-x0)*t, y0+(y1-y0)*t)\nprint('=== TEXT TOP VIEW ===')\nfor row in grid:\n    print(''.join(row))\nPYEOF\npython3 /app/parse3.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
