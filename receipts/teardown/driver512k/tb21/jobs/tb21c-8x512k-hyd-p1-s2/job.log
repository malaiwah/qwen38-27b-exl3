Sending keys: ["cat > /app/bench.py << 'EOF'\nimport time\nimport numpy as np\nimport scipy.linalg as sla\n\nN = 200\n\ndef ref(A):\n    vals, vecs = np.linalg.eig(A)\n    i = np.argmax(np.abs(vals))\n    return vals[i], vecs[:, i]\n\ndef cand_eig_nocheck(A):\n    vals, vecs = sla.eig(A, check_finite=False)\n    i = np.argmax(np.abs(vals))\n    return vals[i], vecs[:, i]\n\ndef cand_eigvals_svd(A):\n    vals = sla.eigvals(A, check_finite=False)\n    i = np.argmax(np.abs(vals))\n    lam = vals[i]\n    # right null vector of (A - lam I) = dominant eigenvector\n    B = A - lam*np.eye(A.shape[0])\n    # smallest singular vector\n    _, _, Vh = np.linalg.svd(B, full_matrices=False)\n    x = Vh[-1, :].conj()\n    return lam, x\n\ndef cand_schur_complex(A):\n    T, Z = sla.schur(A, output='complex', check_finite=False)\n    d = np.diag(T)\n    i = np.argmax(np.abs(d))\n    lam = d[i]\n    # right eigenvector of T (upper triangular) for lam via back-substitution, then Z @ v\n    n = A.shape[0]\n    v = np.zeros(n, dtype=complex)\n    v[n-1] = 1.0\n    for k in range(n-2, -1, -1):\n        s = np.dot(T[k, k+1:], v[k+1:])\n        denom = T[k, k] - lam\n        if abs(denom) < 1e-14:\n            v[k] = 1.0\n        else:\n            v[k] = s/denom\n    x = Z @ v\n    return lam, x\n\nnames = ['ref','cand_eig_nocheck','cand_eigvals_svd','cand_schur_complex']\nfns = [ref, cand_eig_nocheck, cand_eigvals_svd, cand_schur_complex]\n\nfor size in [2,4,6,8,10]:\n    print(f'\\n=== size {size}x{size} ===')\n    for nm, fn in zip(names, fns):\n        # correctness over many random matrices\n        maxres = 0.0\n        for t in range(50):\n            A = np.random.normal(size=(size,size)).astype(np.float64)\n            lam, x = fn(A)\n            res = np.linalg.norm(A@x - lam*x)/np.linalg.norm(x)\n            maxres = max(maxres, res)\n        # timing\n        dts=[]\n        for t in range(N):\n            A = np.random.normal(size=(size,size)).astype(np.float64)\n            t0=time.perf_counter(); fn(A); t1=time.perf_counter()\n            dts.append(t1-t0)\n        med = np.median(dts)\n        print(f'{nm:22s} med={med*1e6:9.3f}us  maxrelres={maxres:.2e}')\nEOF\npython3 /app/bench.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
