Sending keys: ["cd /tmp && cat > rt.py <<'EOF'\nimport math\n\ndef norm(v): l=math.sqrt(sum(a*a for a in v)); return (v[0]/l,v[1]/l,v[2]/l)\ndef dot(a,b): return a[0]*b[0]+a[1]*b[1]+a[2]*b[2]\ndef sub(a,b): return (a[0]-b[0],a[1]-b[1],a[2]-b[2])\ndef add(a,b): return (a[0]+b[0],a[1]+b[1],a[2]+b[2])\ndef mulv(a,s): return (a[0]*s,a[1]*s,a[2]*s)\n\ncenter=(-5.0,-0.5,0.0); radius=1.0\nspcolor=(0.2,0.2,1.0)\nplane_y=-1.5\nplane_normal=(0.0,1.0,0.0)\nlightdir=norm((-1.0,1.0,1.0))\n\ndef sphere_hit(origin,d):\n    oc=sub(origin,center); b=dot(d,oc); c=dot(oc,oc)-radius*radius; disc=b*b-c\n    if disc<0: return (0,0.0,None)\n    s=math.sqrt(disc); t=-b-s\n    if t>0.001:\n        p=add(origin,mulv(d,t)); n=norm(sub(p,center)); return (1,t,n)\n    t=-b+s\n    if t>0.001:\n        p=add(origin,mulv(d,t)); n=norm(sub(p,center)); return (1,t,n)\n    return (0,0.0,None)\n\ndef plane_hit(origin,d):\n    den=dot(plane_normal,d)\n    t=0.0; ok=False\n    if abs(den)>1e-4:\n        t=dot((0,plane_y,0),sub(origin,(0,0,0)))-plane_y  # placeholder\n    # proper: t = (plane_point - origin)·n / (d·n), plane_point=(0,plane_y,0)\n    t=((0,plane_y,0)[1]-origin[1]*0 - origin[1])/0 if False else None\n    # do it cleanly\n    pp=(0.0,plane_y,0.0)\n    t=dot(sub(pp,origin),plane_normal)/den\n    if den<1e-4: return (0,0.0,None)\n    if t>0.001:\n        return (0,t,plane_normal)\n    return (0,0.0,None)\n\ndef in_shadow(origin,d):\n    # is_in_shadow(ray from origin toward lightdir) - here we pass the hit origin & light dir\n    return sphere_hit(add(origin,mulv(lightdir,0.001)),lightdir)[0]==1\n\ndef trace(origin,d,mode):\n    o1,t1,n1=sphere_hit(origin,d)\n    o2,t2,n2=plane_hit(origin,d)\n    obj=0; tmin=0.0; n=None\n    if o1==1:\n        if o2==0 or t2<t1: obj=0; tmin=t2; n=n2\n        else: obj=1; tmin=t1; n=n1\n    else:\n        if o2==1: obj=0; tmin=t2; n=n2\n        else: return sky(d)\n    # obj type: sphere=1, plane=0\n    if obj==1:\n        # sphere\n        typ=1\n    else:\n        typ=0\n    hitp=add(origin,mulv(d,tmin))\n    d2=dot(n,d)\n    if d2<0: d2=0.0\n    # shadow\n    if in_shadow(hitp, lightdir):\n        d2=0.0\n    light=0.2+0.8*d2\n    if typ==1:\n        mat=spcolor\n    else:\n        s=(math.floor(hitp[0])+math.floor(hitp[2]))&1\n        mat=(0.8,0.8,0.8) if s==0 else (0.2,0.2,0.2)\n    return (mat[0]*light,mat[1]*light,mat[2]*light)\n\nc1=(0.7,1.0,0.5); c2=(0.9,1.0,0.9)\ndef sky(d):\n    t=0.5*(d[1]+1.0)\n    return (c1[0]+(c2[0]-c1[0])*t, c1[1]+(c2[1]-c1[1])*t, c1[2]+(c2[2]-c1[2])*t)\n\ndef render(W,H,mode):\n    img=[0]*(W*H*3)\n    A=(8.0/3.0,0,0); B=(0,2.0,0); C=(0,0,1); origin=(0,0,0)\n    for y in range(H):\n        sy=y/(H-1)\n        for x in range(W):\n            sx=x/(W-1)\n            if mode==0:\n                d=sub(add(add(add((0,0,0),mulv(A,sx)),mulv(B,1-sy)),C),origin)\n            else:\n                d=sub(add(add(add((0,0,0),mulv(A,sx)),mulv(B,sy)),C),origin)\n            dn=norm(d)\n            c=trace(origin,dn,mode)\n            i=(y*W+x)*3\n            img[i]=max(0,min(255,int(c[0]*255)))\n            img[i+1]=max(0,min(255,int(c[1]*255)))\n            img[i+2]=max(0,min(255,int(c[2]*255)))\n    return img\n\n# quick layout test at 120x90\nfor mode in [0,1]:\n    W,H=120,90\n    img=render(W,H,mode)\n    chars=' .:-=+*#%@'\n    print('=== mode',mode,'===')\n    for y in range(0,H,4):\n        row=''\n        for x in range(0,W,3):\n            i=(y*W+x)*3; b=(img[i]+img[i+1]+img[i+2])/3\n            row+=chars[min(9,int(b/256*10))]\n        print(row)\nEOF\npython3 rt.py\n"] min_timeout_sec: 40.0 max_timeout_sec: 180.0
