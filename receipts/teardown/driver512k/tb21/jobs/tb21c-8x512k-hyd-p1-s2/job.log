Sending keys: ["cat > /tmp/analyze.py <<'EOF'\nimport sys\ndef load_ppm(path):\n    with open(path,'rb') as f:\n        data=f.read()\n    assert data[:2]==b'P3'\n    # parse header tokens\n    idx=2\n    toks=[]\n    while len(toks)<4:\n        while idx<len(data) and data[idx] in b' \\t\\r\\n':\n            idx+=1\n        if data[idx:idx+1]==b'#':\n            while idx<len(data) and data[idx] not in b'\\n':\n                idx+=1\n            continue\n        start=idx\n        while idx<len(data) and data[idx] not in b' \\t\\r\\n':\n            idx+=1\n        toks.append(int(data[start:idx]))\n    # after 4 tokens, single whitespace\n    while idx<len(data) and data[idx] in b' \\t\\r\\n':\n        idx+=1\n    W,H,maxv=toks[0],toks[1],toks[2]\n    rest=data[idx:].split()\n    vals=[int(x) for x in rest]\n    assert len(vals)>=W*H*3, (len(vals), W*H*3)\n    px=[[ (vals[(y*W+x)*3],vals[(y*W+x)*3+1],vals[(y*W+x)*3+2]) for x in range(W)] for y in range(H)]\n    return W,H,px\nW,H,px=load_ppm('/app/image.ppm')\nprint('size',W,H)\ndef bri(p): return 0.299*p[0]+0.587*p[1]+0.114*p[2]\nchars=' .:-=+*#%@'\ndef show(sx=80, sy=45):\n    for gy in range(sy):\n        row=''\n        for gx in range(sx):\n            x=int(gx*W/sx); y=int(gy*H/sy)\n            b=bri(px[y][x])\n            row+=chars[min(9,int(b/256*10))]\n        print(row)\nshow()\nprint('corners:')\nprint(' TL', px[0][0], 'TR', px[0][W-1])\nprint(' BL', px[H-1][0], 'BR', px[H-1][W-1])\nprint(' center', px[H//2][W//2])\n# find bright/red pixels (ball)\nbest=None\nfor y in range(0,H,3):\n    for x in range(0,W,3):\n        r,g,b=px[y][x]\n        if r>120 and g<120 and b<120:\n            best=(x,y,r,g,b)\nprint('reddish sample', best)\nEOF\npython3 /tmp/analyze.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
