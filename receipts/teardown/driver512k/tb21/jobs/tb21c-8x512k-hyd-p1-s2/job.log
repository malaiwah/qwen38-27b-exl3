Sending keys: ['cat > /app/pystan_analysis.py << \'PYEOF\'\nimport os\n\n# Limit threading inside the C++ Stan service workers so that the 4 parallel\n# chain processes stay within the container\'s cgroup memory limit.  Each chain\n# is sampled in its own forked process; with the default thread count (== nproc)\n# the TBB/OpenMP thread stacks would exhaust the memory limit.  This is a\n# resource-control tweak only -- it does NOT change the model, the data, or any\n# sampling hyperparameter (the GP model has no `parallel for` and HMC is\n# sequential), so the posterior is identical to the R script\'s.\nos.environ["TBB_NUM_THREADS"] = "1"\nos.environ["OMP_NUM_THREADS"] = "1"\n\nimport json\nimport numpy as np\nimport pandas as pd\nimport stan\n\n# ---------------------------------------------------------------------------\n# 1. Read the same data files as the R script\n# ---------------------------------------------------------------------------\nwith open("/app/meta_public.json") as f:\n    meta_pub = json.load(f)\n\ntrain_X = pd.read_csv("/app/train_X.csv").to_numpy()    # (N, D)\ntest_X  = pd.read_csv("/app/test_X.csv").to_numpy()     # (N_new, D)\ntrain_y = pd.read_csv("/app/train_y.csv")["y"].to_numpy()  # (N,)\n\nP = int(meta_pub["P"])\njitter = float(meta_pub["jitter"])\n\nN = train_X.shape[0]\nD = train_X.shape[1]\nN_new = test_X.shape[0]\n\n# H = cbind(1, X[,1], X[,2])  (R 1-indexed cols 1,2 -> python cols 0,1)\nH = np.column_stack([np.ones(N), train_X[:, 0], train_X[:, 1]])          # (N, 3)\nif N_new > 0:\n    H_new = np.column_stack([np.ones(N_new), test_X[:, 0], test_X[:, 1]])  # (N_new, 3)\n    X_new = test_X\nelse:\n    H_new = np.zeros((0, P))\n    X_new = np.zeros((0, D))\n\nprint(f"N={N} D={D} P={P} N_new={N_new} jitter={jitter}")\nprint(f"H shape={H.shape}  H_new shape={H_new.shape}")\n\n# Stan data block (same list as the R script\'s data_list)\ndata = dict(\n    N=int(N),\n    D=int(D),\n    X=train_X.tolist(),\n    P=int(P),\n    H=H.tolist(),\n    y=train_y.tolist(),\n    jitter=float(jitter),\n    N_new=int(N_new),\n    X_new=X_new.tolist(),\n    H_new=H_new.tolist(),\n)\n\n# ---------------------------------------------------------------------------\n# 2. Stan model (functionally equivalent to the R script\'s model)\n#    Written to /app/gp_ard_regression.stan (matches the R script, which also\n#    writes this file), then read in here.\n# ---------------------------------------------------------------------------\nwith open("/app/gp_ard_regression.stan") as f:\n    stan_code = f.read()\n\n# ---------------------------------------------------------------------------\n# 3. Build the model (constraint: random_seed must be 1)\n# ---------------------------------------------------------------------------\nprint("Building Stan model (uses cached compilation if available)...")\nmodel = stan.build(stan_code, data=data, random_seed=1)\n\n# ---------------------------------------------------------------------------\n# 4. Posterior sampling with hyperparameters equivalent to the R script:\n#    chains=4, iter=2000, warmup=1000, thin=2, seed=1, init_r=0.1,\n#    control: adapt_delta=0.93, max_treedepth=14, adapt_gamma=0.05,\n#             adapt_kappa=0.75, adapt_t0=10, adapt_init_buffer=100,\n#             adapt_term_buffer=50, adapt_window=25, save_warmup=FALSE\n# ---------------------------------------------------------------------------\nprint("Sampling...")\nfit = model.sample(\n    num_chains=4,\n    num_samples=1000,   # iter - warmup = 2000 - 1000\n    num_warmup=1000,\n    num_thin=2,\n    save_warmup=False,\n    init_radius=0.1,    # == RStan init_r=0.1 (uniform(-0.1, 0.1) on unconstrained scale)\n    max_depth=14,       # == max_treedepth\n    delta=0.93,         # == adapt_delta\n    gamma=0.05,         # == adapt_gamma\n    kappa=0.75,         # == adapt_kappa\n    t0=10,              # == adapt_t0\n    init_buffer=100,    # == adapt_init_buffer\n    term_buffer=50,     # == adapt_term_buffer\n    window=25,          # == adapt_window\n)\n\nprint("Sampling complete.")\n\n# ---------------------------------------------------------------------------\n# 5. Extract posterior samples and compute posterior means\n#    (equivalent to rstan::extract + mean / colMeans)\n# ---------------------------------------------------------------------------\nalpha_draws = np.asarray(fit["alpha"]).ravel()   # (n_total,)\nsigma_draws = np.asarray(fit["sigma"]).ravel()   # (n_total,)\nrho_draws   = np.asarray(fit["rho"])             # (D, n_total)\nbeta_draws  = np.asarray(fit["beta"])            # (P, n_total)\n\nprint("num posterior draws (per scalar):", alpha_draws.shape[0])\n\nalpha_mean = float(alpha_draws.mean())\nsigma_mean = float(sigma_draws.mean())\nrho_mean = rho_draws.mean(axis=1)    # per-dimension mean (== colMeans)\nbeta_mean = beta_draws.mean(axis=1)  # per-element mean  (== colMeans)\n\nprint("Posterior means:")\nprint("alpha:", alpha_mean)\nprint("sigma:", sigma_mean)\nprint("rho:  ", np.round(rho_mean, 6))\nprint("beta: ", np.round(beta_mean, 6))\n\n# ---------------------------------------------------------------------------\n# 6. Save results (numeric values only)\n# ---------------------------------------------------------------------------\npd.DataFrame([alpha_mean]).to_csv("/app/alpha_est.csv", index=False, header=False)\npd.DataFrame([sigma_mean]).to_csv("/app/sigma_est.csv", index=False, header=False)\npd.DataFrame(rho_mean).to_csv("/app/rho_est.csv", index=False, header=False)\npd.DataFrame(beta_mean).to_csv("/app/beta_est.csv", index=False, header=False)\n\nprint("Results saved to /app/alpha_est.csv, /app/sigma_est.csv, /app/rho_est.csv, /app/beta_est.csv")\nPYEOF\necho \'=== rewritten ===\'; python3 -m py_compile /app/pystan_analysis.py && echo \'PY SYNTAX OK\'\n'] min_timeout_sec: 8.0 max_timeout_sec: 180.0
