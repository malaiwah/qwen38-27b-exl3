Sending keys: ["cd /tmp && cat > rt2.py <<'EOF'\nimport math\n\ndef norm(v): l=math.sqrt(sum(a*a for a in v)); return (v[0]/l,v[1]/l,v[2]/l)\ndef dot(a,b): return a[0]*b[0]+a[1]*b[1]+a[2]*b[2]\ndef sub(a,b): return (a[0]-b[0],a[1]-b[1],a[2]-b[2])\ndef add(a,b): return (a[0]+b[0],a[1]+b[1],a[2]+b[2])\ndef mulv(a,s): return (a[0]*s,a[1]*s,a[2]*s)\n\ncenter=(0.0,-0.5,-5.0); radius=1.0\nspcolor=(0.2,0.2,1.0)\nplane_y=-1.5\nplane_normal=(0.0,1.0,0.0)\nlightdir=norm((1.0,1.0,-1.0))\nc1=(0.7,1.0,0.5); c2=(0.9,1.0,0.9)\n\ndef sphere_hit(o,d):\n    oc=sub(o,center); b=dot(d,oc); c=dot(oc,oc)-radius*radius; disc=b*b-c\n    if disc<0: return (0,0.0,None)\n    s=math.sqrt(disc); t=-b-s\n    if t>0.001: p=add(o,mulv(d,t)); return (1,t,norm(sub(p,center)))\n    t=-b+s\n    if t>0.001: p=add(o,mulv(d,t)); return (1,t,norm(sub(p,center)))\n    return (0,0.0,None)\n\ndef plane_hit(o,d):\n    den=dot(plane_normal,d)\n    if abs(den)<1e-4: return (0,0.0,None)\n    t=(plane_y-o[1])/den   # (pp.y - o.y)/den, pp.y=plane_y, n=(0,1,0)\n    if t>0.001: return (0,t,plane_normal)\n    return (0,0.0,None)\n\ndef in_shadow(o,d):\n    return sphere_hit(add(o,mulv(d,0.001)),d)[0]==1\n\ndef sky(d):\n    t=0.5*(d[1]+1.0)\n    return (c1[0]+(c2[0]-c1[0])*t,c1[1]+(c2[1]-c1[1])*t,c1[2]+(c2[2]-c1[2])*t)\n\ndef trace(o,d):\n    o1,t1,n1=sphere_hit(o,d)\n    o2,t2,n2=plane_hit(o,d)\n    if o1==0 and o2==0: return sky(d)\n    if o1==1 and (o2==0 or t1<t2):\n        typ,t,n=1,t1,n1\n    elif o2==1:\n        typ,t,n=0,t2,n2\n    else:\n        return sky(d)\n    hitp=add(o,mulv(d,t))\n    diff=dot(n,d)\n    if diff<0: diff=0.0\n    if in_shadow(hitp,lightdir): diff=0.0\n    light=0.2+0.8*diff\n    if typ==1: mat=spcolor\n    else:\n        s=(int(math.floor(hitp[0]))+int(math.floor(hitp[2])))&1\n        mat=(0.8,0.8,0.8) if s==0 else (0.2,0.2,0.2)\n    return (mat[0]*light,mat[1]*light,mat[2]*light)\n\ndef render(W,H,dirfn,origin=(0,0,0)):\n    img=[0]*(W*H*3)\n    for y in range(H):\n        sy=y/(H-1)\n        for x in range(W):\n            sx=x/(W-1)\n            d=dirfn(sx,sy)\n            dn=norm(d)\n            c=trace(origin,dn)\n            i=(y*W+x)*3\n            img[i]=max(0,min(255,int(c[0]*255)))\n            img[i+1]=max(0,min(255,int(c[1]*255)))\n            img[i+2]=max(0,min(255,int(c[2]*255)))\n    return img\n\nF={\n 'A':lambda sx,sy:(8/3*sx,-2*(1-sy),1),\n 'B':lambda sx,sy:(-4/3+8/3*sx,1-2*sy,-1),\n 'C':lambda sx,sy:(-4/3+8/3*sx,-1+2*sy,-1),\n 'D':lambda sx,sy:(-4/3+8/3*sx,1-2*sy,1),\n}\nchars=' .:-=+*#%@'\ndef ascii_img(img,W,H):\n    out=[]\n    for y in range(0,H,4):\n        row=''\n        for x in range(0,W,3):\n            i=(y*W+x)*3; b=(img[i]+img[i+1]+img[i+2])/3\n            row+=chars[min(9,int(b/256*10))]\n        out.append(row)\n    return '\\n'.join(out)\nfor k,f in F.items():\n    img=render(120,90,f)\n    print('=== formula',k,'===')\n    print(ascii_img(img,120,90))\nEOF\npython3 rt2.py\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
