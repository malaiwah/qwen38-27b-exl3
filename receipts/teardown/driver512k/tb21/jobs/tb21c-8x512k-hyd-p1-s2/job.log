Sending keys: ['cat > /app/eigen.py << \'EOF\'\nimport numpy as np\nimport scipy.linalg._flapack as _flapack\n\n_dgeev = _flapack.dgeev\n\n\ndef find_dominant_eigenvalue_and_eigenvector(A: np.ndarray):\n    """\n    Find the dominant eigenvalue (largest magnitude) and its eigenvector of a\n    general real square matrix (may have complex eigen pairs).\n\n    Args:\n        A: Real-valued square matrix (numpy array), dtype float64, size <= 10x10.\n\n    Returns:\n        eigenvalue: dominant eigenvalue (numpy scalar, possibly complex)\n        eigenvector: corresponding eigenvector (np.ndarray, possibly complex)\n    """\n    A = np.ascontiguousarray(A, dtype=np.float64)\n    n = A.shape[0]\n    # Right eigenvectors only (compute_vl=0, compute_vr=1). overwrite_a=0 keeps A intact.\n    wr, wi, _vl, vr, info = _dgeev(A, 0, 1, max(4 * n, 1), 0)\n    if info:\n        raise np.linalg.LinAlgError("dgeev did not converge")\n    lam_complex = wr + 1j * wi\n    idx = int(np.argmax(np.abs(lam_complex)))\n    lam = lam_complex[idx]\n    # Reconstruct the right eigenvector. Complex conjugate pairs occupy two\n    # consecutive columns; the member with positive imaginary part is first.\n    w = wi[idx]\n    if w > 0:\n        x = vr[:, idx] + 1j * vr[:, idx + 1]\n    elif w < 0:\n        # Conjugate member of the pair starting at idx-1.\n        x = vr[:, idx - 1] - 1j * vr[:, idx]\n    else:\n        x = vr[:, idx].astype(np.complex128)\n    # Normalize so the result is a well-conditioned vector (avoids underflow in\n    # the residual norm check); scaling does not change the eigen equation.\n    norm = np.linalg.norm(x)\n    if norm != 0:\n        x = x / norm\n    return lam, x\nEOF\npython3 -c "\nimport numpy as np\nfrom eigen import find_dominant_eigenvalue_and_eigenvector as f\n# complex dominant test\nfor A in [\n  np.array([[0.5,-2.0],[2.0,0.5]]),\n  np.array([[0.0,-3.0,1.0],[3.0,0.0,0.5],[0.5,0.0,0.1]]),\n]:\n  lam,x=f(A)\n  res=np.linalg.norm(A@x-lam*x)/np.linalg.norm(x)\n  print(\'complex-dom\', A.shape, \'lam=\',lam,\'res=\',res)\n# stress over random\nworst=0\nfor t in range(2000):\n    n=np.random.randint(2,11)\n    A=np.random.normal(size=(n,n))\n    lam,x=f(A)\n    res=np.linalg.norm(A@x-lam*x)/np.linalg.norm(x)\n    worst=max(worst,res)\nprint(\'worst random residual over 2000 =\', worst)\n"\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
