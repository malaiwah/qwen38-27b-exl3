Sending keys: ['cat > /app/eigen.py << \'EOF\'\nimport numpy as np\nimport scipy.linalg._flapack as _flapack\n\n_dgeev = _flapack.dgeev\n\n\ndef find_dominant_eigenvalue_and_eigenvector(A: np.ndarray):\n    """\n    Find the dominant eigenvalue (largest magnitude) and its eigenvector of a\n    general real square matrix (the pair may be complex).\n\n    Args:\n        A: Real-valued square matrix (numpy array), dtype float64, size <= 10x10.\n\n    Returns:\n        eigenvalue: dominant eigenvalue (numpy scalar, possibly complex)\n        eigenvector: corresponding eigenvector (np.ndarray, possibly complex,\n                     unit 2-norm)\n    """\n    A = np.ascontiguousarray(A, dtype=np.float64)\n    n = A.shape[0]\n    # Right eigenvectors only (compute_vl=0, compute_vr=1); overwrite_a=0 keeps A intact.\n    wr, wi, _vl, vr, info = _dgeev(A, 0, 1, max(4 * n, 1), 0)\n    if info:\n        raise np.linalg.LinAlgError("dgeev did not converge")\n    # |lambda| = hypot(real, imag); avoids building a complex array.\n    idx = int(np.argmax(np.hypot(wr, wi)))\n    lam = wr[idx] + 1j * wi[idx]\n    # LAPACK stores complex-conjugate pairs in two consecutive columns, the\n    # member with the positive imaginary part first, and unit-normalizes them.\n    w = wi[idx]\n    if w > 0:\n        x = vr[:, idx] + 1j * vr[:, idx + 1]\n    elif w < 0:\n        x = vr[:, idx - 1] - 1j * vr[:, idx]\n    else:\n        x = vr[:, idx].astype(np.complex128)\n    return lam, x\nEOF\npython3 -c "\nimport time,numpy as np\nfrom eigen import find_dominant_eigenvalue_and_eigenvector as f\ndef ref(A):\n    v,x=np.linalg.eig(A); i=np.argmax(np.abs(v)); return v[i],x[:,i]\n# correctness stress\nworst=0.0\nfor t in range(4000):\n    n=np.random.randint(2,11)\n    A=np.random.normal(size=(n,n))\n    lam,x=f(A)\n    res=np.linalg.norm(A@x-lam*x)/np.linalg.norm(x)\n    worst=max(worst,res)\n    assert res<1e-9\nprint(\'worst residual:\', worst)\n# speed all sizes, median of 200, alternating fresh matrices\nfor size in [2,4,6,8,10]:\n    for nm,fn in [(\'mine\',f),(\'ref\',ref)]:\n        dts=[]\n        for _ in range(200):\n            A=np.random.normal(size=(size,size)).astype(np.float64)\n            t0=time.perf_counter(); fn(A); t1=time.perf_counter(); dts.append(t1-t0)\n        print(f\'{size}x{size} {nm:4s}: median={np.median(dts)*1e6:8.3f}us  min={np.min(dts)*1e6:8.3f}us\')\n"\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
