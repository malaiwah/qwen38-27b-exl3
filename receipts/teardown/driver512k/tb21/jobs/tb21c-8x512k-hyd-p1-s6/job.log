ask_l], 1)[0]\n            sr=np.polyfit(t[a:b+1][mask_r], y[a:b+1][mask_r], 1)[0]\n        else:\n            sl=s[i-1] if i>0 else 0.0\n            sr=s[i] if i<len(s) else 0.0\n        if abs(sr-sl)>thresh:\n            out.append((tau, sl, sr))\n    return out\n\nnp.random.seed(123)\nA1_true=forward.A1\nclusters=[]\nsupport=[]\nfor li in range(5):\n    v=np.random.randn(D); v/=np.linalg.norm(v)\n    p=np.zeros(D)\n    ks=kinks_on_line(p,v,N=6000)\n    print('line',li,'kinks',len(ks))\n    for idx,(tau,sl,sr) in enumerate(ks):\n        # choose epsilon based on neighboring kinks\n        dists=[]\n        for j,(t2,_,_) in enumerate(ks):\n            if j!=idx:\n                dists.append(abs(t2-tau))\n        eps=0.03\n        if dists:\n            eps=min(0.05, max(1e-4, min(dists)/4))\n        xplus=p+(tau+eps)*v\n        xminus=p+(tau-eps)*v\n        gp=grad(xplus, h=1e-7)\n        gm=grad(xminus, h=1e-7)\n        diff=gp-gm\n        nrm=np.linalg.norm(diff)\n        if nrm < 1e-7:\n            continue\n        u=diff/nrm\n        # cluster\n        placed=False\n        for ci,mean in enumerate(clusters):\n            c=np.dot(u,mean)\n            if abs(c)>0.95:\n                if c<0: u=-u\n                clusters[ci]=(clusters[ci]+u)/(support[ci]+1)\n                support[ci]+=1\n                placed=True\n                break\n        if not placed:\n            clusters.append(u.copy())\n            support.append(1)\nprint('clusters',len(clusters), 'support', support)\n# match to true A1\ntrue_u=A1_true/np.linalg.norm(A1_true,axis=1,keepdims=True)\nfor ci,u in enumerate(clusters):\n    dots=np.abs(true_u @ u)\n    j=int(np.argmax(dots))\n    print(ci, 'support', support[ci], 'best row', j, 'absdot', dots[j])\nPY\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
