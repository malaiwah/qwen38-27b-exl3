Sending keys: ["cd /app && python3 << 'EOF'\nimport json\nfrom PIL import Image\n\nw = json.load(open('weights.json'))\nw_in = w['input_layer']['weight'];  b_in = w['input_layer']['bias']\nw_h  = w['hidden_layer']['weight'];  b_h = w['hidden_layer']['bias']\nw_out = w['output_layer']['weight']; b_out = w['output_layer']['bias']\n\nIN, H, OUT = 784, 16, 10\ndef linear(vec, W, B, in_f, out_f):\n    # W flat row-major [out_f, in_f]; index o*in_f + i\n    out = [0.0]*out_f\n    for o in range(out_f):\n        s = B[o]\n        base = o*in_f\n        for i in range(in_f):\n            s += W[base+i]*vec[i]\n        out[o]=s\n    return out\n\ndef relu(v): return [max(0.0,x) for x in v]\n\ndef forward(x):\n    h = relu(linear(x, w_in, b_in, IN, H))\n    h2 = relu(linear(h, w_h, b_h, H, H))\n    o = linear(h2, w_out, b_out, H, OUT)\n    return o\n\nimg = Image.open('image.png').convert('L')\npixels = list(img.getdata())\nprint('num pixels', len(pixels), 'min', min(pixels), 'max', max(pixels))\n\nimport math\nmean = sum(pixels)/len(pixels)\nvar = sum((p-mean)**2 for p in pixels)/len(pixels)\nstd = math.sqrt(var)\nprint('mean', mean, 'std', std)\n\n# candidate normalizations\ncands = {\n  'p/255': [p/255.0 for p in pixels],\n  '(p-127.5)/128': [(p-127.5)/128.0 for p in pixels],\n  'p/255 inverted (1-p/255)': [1.0-p/255.0 for p in pixels],\n  '(mean127.5/std31.0)': [(p-127.5)/31.0 for p in pixels],\n  'std_mean': [(p-mean)/std for p in pixels],\n}\nfor name,x in cands.items():\n    o = forward(x)\n    # softmax\n    m = max(o); e=[math.exp(v-m) for v in o]; s=sum(e); sm=[v/s for v in e]\n    pred = o.index(max(o))\n    print(f'{name}: pred={pred} top_probs={[round(v,3) for v in sm]}')\nEOF\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
