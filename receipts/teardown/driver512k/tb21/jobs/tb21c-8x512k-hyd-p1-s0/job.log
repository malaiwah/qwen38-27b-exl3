Sending keys: ['cat << \'PYEOF\' > /app/fit_peaks.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\n# Read data file - convert European decimal format (comma) to standard (period)\ndata = []\nwith open(\'/app/graphene.dat\', \'r\') as f:\n    for line in f:\n        line = line.strip()\n        if line:\n            parts = line.split()\n            x = float(parts[0].replace(\',\', \'.\'))\n            y = float(parts[1].replace(\',\', \'.\'))\n            data.append((x, y))\n\ndata = np.array(data)\nx = data[:, 0]\ny = data[:, 1]\n\n# Sort by x\nsort_idx = np.argsort(x)\nx = x[sort_idx]\ny = y[sort_idx]\n\nprint(f"Data range: {x.min():.1f} to {x.max():.1f} cm-1")\nprint(f"Intensity range: {y.min():.1f} to {y.max():.1f}")\n\n# Lorentzian function\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\ndef fit_peak(x, y, x_center, window):\n    # Select data in window around the peak\n    mask = (x > x_center - window) & (x < x_center + window)\n    x_fit = x[mask]\n    y_fit = y[mask]\n    \n    # Initial guesses\n    x0_guess = x_center\n    offset_guess = np.median(y_fit)\n    amplitude_guess = np.max(y_fit) - offset_guess\n    gamma_guess = 15  # typical HWHM for G peak\n    \n    # Refine x0 guess to where intensity is maximum\n    x0_guess = x_fit[np.argmax(y_fit)]\n    \n    p0 = [x0_guess, gamma_guess, amplitude_guess, offset_guess]\n    \n    try:\n        popt, pcov = curve_fit(lorentzian, x_fit, y_fit, p0=p0, maxfev=10000)\n        x0, gamma, amplitude, offset = popt\n        gamma = abs(gamma)  # gamma should be positive\n        print(f"  x0={x0:.2f}, gamma={gamma:.2f}, amplitude={amplitude:.2f}, offset={offset:.2f}")\n        return {\'x0\': float(x0), \'gamma\': float(gamma), \'amplitude\': float(amplitude), \'offset\': float(offset)}\n    except Exception as e:\n        print(f"  Fitting failed: {e}")\n        return {\'x0\': x0_guess, \'gamma\': gamma_guess, \'amplitude\': amplitude_guess, \'offset\': offset_guess}\n\n# G peak is around 1580 cm-1\nprint("\\nFitting G peak (~1580 cm-1):")\ng_results = fit_peak(x, y, 1580, 100)\n\n# 2D peak is around 2700 cm-1\nprint("\\nFitting 2D peak (~2700 cm-1):")\nresults_2d = fit_peak(x, y, 2700, 150)\n\nresults = {\n    "G": g_results,\n    "2D": results_2d\n}\n\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nprint("\\nResults written to /app/results.json")\nprint(json.dumps(results, indent=2))\nPYEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
