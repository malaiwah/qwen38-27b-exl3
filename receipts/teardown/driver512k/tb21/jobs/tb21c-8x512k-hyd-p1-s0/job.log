Sending keys: ['cat > /app/pipeline_parallel.py << \'PYEOF\'\n"""Pipeline-parallel training step (all-forward-all-backward, AFAB) for LLaMA.\n\n``train_step_pipeline_afab`` splits a ``LlamaForCausalLM``\'s transformer blocks\nacross pipeline stages and runs one training step using AFAB scheduling:\nthe forward pass is run for every micro-batch first, then the backward pass.\n\nDesign\n------\n* Every rank receives the *full* model but only executes its own contiguous\n  slice of ``model.model.layers`` (determined from ``rank`` / ``world_size``).\n* Rank 0 turns the input ids into hidden states with ``embed_tokens``.\n* The last rank applies the final ``norm`` + ``lm_head`` and computes the\n  (shifted) cross-entropy loss.  The loss is divided by the number of\n  micro-batches so that the resulting gradients are exactly equal to those of a\n  single, un-partitioned model that processes the whole batch at once.\n* Between stages the hidden state ``[microbatch, seq_len, hidden_size]`` is\n  exchanged with ``torch.distributed.P2POp`` (``isend``/``irecv``).\n* The autograd graph is broken at every P2P boundary, so it is re-attached\n  manually: incoming hidden states are made leaves (``requires_grad``) and, in\n  the backward phase, the upstream gradient is used with\n  ``torch.autograd.backward`` to propagate gradients locally before the incoming\n  hidden state\'s gradient is sent back to the previous stage.\n\nThe causal mask, position ids and rotary embeddings are recomputed locally on\nevery rank and are identical to the ones the reference (un-partitioned) model\nuses, which guarantees bit-for-bit (up to float rounding) matching activations\nand gradients.\n"""\n\nimport torch\nimport torch.nn.functional as F\nimport torch.distributed as dist\n\n\n# --------------------------------------------------------------------------- #\n# small helpers\n# --------------------------------------------------------------------------- #\ndef _layer_ranges(num_layers, world_size):\n    """Split ``num_layers`` into ``world_size`` contiguous, roughly balanced ranges."""\n    if world_size <= 1:\n        return [(0, num_layers)]\n    base, extra = divmod(num_layers, world_size)\n    ranges, start = [], 0\n    for r in range(world_size):\n        cnt = base + (1 if r < extra else 0)\n        ranges.append((start, start + cnt))\n        start += cnt\n    return ranges\n\n\ndef _isend(tensor, peer, tag=0):\n    """Async send ``tensor`` to ``peer`` (P2POp) returning the handles."""\n    return dist.batch_isend_irecv([dist.P2POp(dist.isend, tensor, peer, tag=tag)])\n\n\ndef _irecv(tensor, peer, tag=0):\n    """Async receive into ``tensor`` from ``peer`` (P2POp) returning the handles."""\n    return dist.batch_isend_irecv([dist.P2POp(dist.irecv, tensor, peer, tag=tag)])\n\n\ndef _wait(handles):\n    for h in handles:\n        h.wait()\n\n\n# --------------------------------------------------------------------------- #\n# main entry point\n# --------------------------------------------------------------------------- #\ndef train_step_pipeline_afab(model, inputs, targets, device, dtype):\n    """Run one pipeline-parallel training step (AFAB schedule).\n\n    Parameters\n    ----------\n    model : LlamaForCausalLM\n        The full model.  This rank only executes its own slice of\n        ``model.model.layers``; rank 0 additionally uses ``embed_tokens`` and the\n        last rank additionally uses ``norm`` / ``lm_head``.\n    inputs : list[Tensor]\n        Micro-batches of input ids, each ``[microbatch, seq_len]``.\n    targets : list[Tensor]\n        Micro-batches of target ids, each ``[microbatch, seq_len]``.\n    device : torch.device\n    dtype : torch.dtype\n\n    Returns\n    -------\n    Tensor or None\n        The (scaled) scalar loss on the last rank, ``None`` otherwise.\n    """\n    from transformers.masking_utils import create_causal_mask\n\n    rank = dist.get_rank() if dist.is_initialized() else 0\n    world = dist.get_world_size() if dist.is_initialized() else 1\n\n    model.train()\n\n    num_layers = model.config.num_hidden_layers\n    start, end = _layer_ranges(num_layers, world)[rank]\n    local_layers = list(model.model.layers[start:end])\n\n    is_first = (rank == 0)\n    is_last = (rank == world - 1)\n\n    num_micro = len(inputs)\n    seq_len = inputs[0].shape[-1]\n    microbatch = inputs[0].shape[0]\n    hidden = model.config.hidden_size\n    vocab = model.config.vocab_size\n\n    # ---- attention / position info (identical on every rank) ------------- #\n    position_ids = torch.arange(seq_len, device=device, dtype=torch.long).unsqueeze(0)\n    dummy = torch.empty(microbatch, seq_len, hidden, device=device, dtype=dtype)\n    causal_mask = create_causal_mask(\n        config=model.config,\n        inputs_embeds=dummy,\n        attention_mask=None,\n        past_key_values=None,\n        position_ids=position_ids,\n    )\n\n    # ---- per-microbatch storage ------------------------------------------ #\n    H_in = []    # incoming hidden state (rank0: embed output, others: recv leaf)\n    H_out = []   # outgoing hidden state (output of this rank\'s layers)\n    logits = []  # last rank only\n\n    def recv_hidden():\n        t = torch.empty(microbatch, seq_len, hidden, device=device, dtype=dtype)\n        _wait(_irecv(t, rank - 1, tag=0))\n        return t\n\n    # ============================ ALL-FORWARD ============================ #\n    for mb in range(num_micro):\n        if is_first:\n            ids = inputs[mb].to(device=device, dtype=torch.long)\n            h_in = model.model.embed_tokens(ids).to(dtype)\n        else:\n            h_in = recv_hidden()\n            h_in.requires_grad_(True)          # leaf so we can read its .grad\n        h_in = h_in.contiguous()\n        H_in.append(h_in)\n\n        pos_emb = model.model.rotary_emb(h_in, position_ids)\n        h = h_in\n        for layer in local_layers:\n            h = layer(\n                h,\n                attention_mask=ca