   recv_f, send_f, recv_b, send_b = [], [], [], []\n    grads = []          # list of (tensor, grad) captured from each layer\'s backprop\n    logits_list = []    # only on the last rank\n    loss = None\n\n    seq_len = inputs[0].shape[-1]\n\n    # ---- causal mask / position ids / rotary (identical on every rank) --\n    dummy = torch.empty(1, seq_len, model.config.hidden_size, device=device, dtype=dtype)\n    position_ids = torch.arange(seq_len, device=device).unsqueeze(0)\n    causal_mask = create_causal_mask(\n        config=model.config,\n        inputs_embeds=dummy,\n        attention_mask=None,\n        past_key_values=None,\n        position_ids=position_ids,\n    )\n\n    # ------------------------------------------------------------------ #\n    # ALL-FORWARD                                                        #\n    # ------------------------------------------------------------------ #\n    for mb in range(num_micro):\n        h = None\n        if is_first:\n            # input ids -> embeddings on the entry stage\n            ids = inputs[mb].to(device=device, dtype=torch.long)\n            h = model.model.embed_tokens(ids).to(dtype)\n\n        if h is None:\n            # receive the hidden state from the previous stage\n            h = torch.empty(inputs[mb].shape[0], seq_len, model.config.hidden_size,\n                            device=device, dtype=dtype)\n            req = _p2p_recv(h, rank - 1, tag=0)\n            for r in req:\n                r.wait()\n\n        h = h.contiguous()\n        recv_f.append(h)  # the tensor that the *incoming* autograd graph will attach to\n\n        # run this stage\'s layers\n        pos_emb = model.model.rotary_emb(h, position_ids)\n        for layer in layers:\n            h = layer(\n                h,\n                attention_mask=causal_mask,\n                position_ids=position_ids,\n                position_embeddings=pos_emb,\n                use_cache=False,\n            )\n\n        if is_last:\n