Sending keys: ['cat > /app/pipeline_parallel.py << \'PYEOF\'\n"""Pipeline-parallel training for a LLaMA model (all-forward-all-backward scheduling).\n\nThe model\'s transformer blocks are partitioned across pipeline stages.  Each\nstage holds a contiguous slice of the decoder layers together with the\nnon-layer components it is responsible for (embedding on the first stage and\nthe final RMSNorm + LM head on the last stage).  Between stages the hidden\nstates are exchanged with point-to-point (P2P) communication.\n\nScheduling: run the forward pass for every micro-batch first (all-forward)\nand then run the backward pass for every micro-batch (all-backward), i.e.\nAFAB.  The loss on the last stage is divided by the number of micro-batches\nso that the resulting gradients equal those of a single, un-partitioned model\nthat sees the concatenated batch at once.\n"""\n\nimport torch\nimport torch.distributed as dist\n\n\n# --------------------------------------------------------------------------- #\n# helpers\n# --------------------------------------------------------------------------- #\ndef _p2p_send(tensor, peer, tag=0):\n    """Send `tensor` to `peer` and return the send handle."""\n    send_op = dist.P2POp(dist.isend, tensor, peer)\n    return dist.batch_isend_irecv([send_op])\n\n\ndef _p2p_recv(tensor, peer, tag=0):\n    """Receive into `tensor` from `peer` and return the receive handle."""\n    recv_op = dist.P2POp(dist.irecv, tensor, peer)\n    return dist.batch_isend_irecv([recv_op])\n\n\ndef _layer_ranges(num_layers, world_size):\n    """Split `num_layers` into `world_size` contiguous, roughly balanced ranges."""\n    if world_size <= 1:\n        return [(0, num_layers)]\n    base, extra = divmod(num_layers, world_size)\n    ranges, start = [], 0\n    for r in range(world_size):\n        cnt = base + (1 if r < extra else 0)\n        ranges.append((start, start + cnt))\n        start += cnt\n    return ranges\n\n\ndef _send_recv(handles, send_tensor, recv_tensor, send_peer, recv_peer):\n    """Fire a (send, recv) pair and wait for both to complete."""\n    ops = []\n    if send_tensor is not None:\n        ops.append(dist.P2POp(dist.isend, send_tensor, send_peer))\n    if recv_tensor is not None:\n        ops.append(dist.P2POp(dist.irecv, recv_tensor, recv_peer))\n    reqs = dist.batch_isend_irecv(ops)\n    for r in reqs:\n        r.wait()\n\n\ndef _rebuild_model(model):\n    """Re-assemble a full LlamaForCausalLM from a partitioned model.\n\n    Each rank stores only its own layers; everything else is a placeholder.\n    We copy each rank\'s layers (and, when available, its head components) into\n    a fresh full model.  Used only by the self-test / reference comparison.\n    """\n    from transformers import LlamaForCausalLM\n\n    cfg = model.config\n    full = LlamaForCausalLM(cfg)\n    if cfg.tie_word_embeddings:\n        full.tie_weights()\n    if dist.is_initialized():\n        world = dist.get_world_size()\n        ranges = _layer_ranges(cfg.num_hidden_layers, world)\n        for r in range(world):\n            t = [torch.empty_like(p) for p in model.parameters()]\n            dist.broadcast_object_list(t, src=r)\n            for idx, (a, b) in enumerate(ranges):\n                pass\n    return full\n\n\ndef _reference_forward(model, inputs, targets, device, dtype, loss_function):\n    """Plain (non-parallel) forward+backward for a *complete* model.\n\n    Returns (logits, loss, grads) where grads is the list of .grad tensors\n    matching `model.parameters()` order.  Used by the self-test.\n    """\n    model.train()\n    model.zero_grad()\n    inb = torch.cat([i.to(device=device, dtype=torch.long) for i in inputs], dim=0)\n    tgt = torch.cat([t.to(device=device, dtype=torch.long) for t in targets], dim=0)\n    out = model(input_ids=inb.to(dtype))\n    logits = out.logits\n    loss = loss_function(logits=logits, labels=tgt, vocab_size=model.config.vocab_size)\n    loss.backward()\n    grads = [p.grad.detach(