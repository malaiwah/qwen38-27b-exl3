Sending keys: ['cat << \'PYEOF\' > /app/compare.py\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = []\nwith open(\'/app/graphene.dat\', \'r\') as f:\n    for line in f:\n        line = line.strip()\n        if line:\n            parts = line.split()\n            x = float(parts[0].replace(\',\', \'.\'))\n            y = float(parts[1].replace(\',\', \'.\'))\n            data.append((x, y))\ndata = np.array(data)\norder = np.argsort(data[:,0])\nx = data[order,0]; y = data[order,1]\n\ndef L(x, x0, g, a, o):\n    return a*g**2/((x-x0)**2+g**2) + o\n\nprint("=== G peak: single Lorentzian + offset, various windows ===")\nfor lo,hi in [(17400,21200),(17800,20800),(18000,20500),(18200,20300),(17600,21000)]:\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p0=[xs[np.argmax(ys)],430,ys.max()-np.median(ys),np.median(ys)]\n    try:\n        po,_=curve_fit(L,xs,ys,p0=p0,maxfev=20000)\n        x0,g,a,o=po; g=abs(g)\n        r=ys-L(xs,x0,g,a,o); rms=np.sqrt(np.mean(r**2))\n        print(f"  [{lo},{hi}] x0={x0:9.1f} g={g:7.1f} a={a:9.1f} o={o:8.1f} RMS={rms:8.1f} n={len(xs)}")\n    except Exception as e:\n        print(f"  [{lo},{hi}] failed {e}")\n\nprint("\\n=== G peak: TWO Lorentzians (G + D-wing) + offset ===")\ndef twoL(x, x1,g1,a1,o1, x2,g2,a2,o2):\n    return a1*g1**2/((x-x1)**2+g1**2)+o1 + a2*g2**2/((x-x2)**2+g2**2)+o2\nfor lo,hi in [(16500,21500),(17000,21500),(16500,20800)]:\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p0=[19140,450,66000,12500, 16245,900,4000,12500]\n    try:\n        po,_=curve_fit(twoL,xs,ys,p0=p0,maxfev=50000)\n        x1,g1,a1,o1,x2,g2,a2,o2=po\n        r=ys-twoL(xs,*po); rms=np.sqrt(np.mean(r**2))\n        print(f"  [{lo},{hi}] G:x0={x1:.1f} g={abs(g1):.1f} a={a1:.1f} o={o1:.1f} | D:x0={x2:.1f} g={abs(g2):.1f} a={a2:.1f} o={o2:.1f} RMS={rms:.1f}")\n    except Exception as e:\n        print(f"  [{lo},{hi}] failed {e}")\n\nprint("\\n=== 2D peak: single Lorentzian + offset, various windows ===")\nfor lo,hi in [(30800,35600),(31000,35400),(31500,35000),(30500,36000)]:\n    m=(x>=lo)&(x<=hi); xs,ys=x[m],y[m]\n    p0=[xs[np.argmax(ys)],1000,ys.max()-np.median(ys),np.median(ys)]\n    try:\n        po,_=curve_fit(L,xs,ys,p0=p0,maxfev=20000)\n        x0,g,a,o=po; g=abs(g)\n        r=ys-L(xs,x0,g,a,o); rms=np.sqrt(np.mean(r**2))\n        print(f"  [{lo},{hi}] x0={x0:9.1f} g={g:7.1f} a={a:9.1f} o={o:8.1f} RMS={rms:8.1f} n={len(xs)}")\n    except Exception as e:\n        print(f"  [{lo},{hi}] failed {e}")\nPYEOF\npython3 /app/compare.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
