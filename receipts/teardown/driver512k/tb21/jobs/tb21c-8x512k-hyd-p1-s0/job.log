Sending keys: ['cat > /app/program.py << \'PYEOF\'\nimport os\nimport sys\n\nBASE = os.path.dirname(os.path.abspath(__file__))\nACCOUNTS = os.path.join(BASE, \'data\', \'ACCOUNTS.DAT\')\nBOOKS = os.path.join(BASE, \'data\', \'BOOKS.DAT\')\nTRANS = os.path.join(BASE, \'data\', \'TRANSACTIONS.DAT\')\nINPUT = os.path.join(BASE, \'src\', \'INPUT.DAT\')\n\nACC_LEN = 34\nBOOK_LEN = 28\nTRANS_LEN = 22\nIN_LEN = 22\n\n\ndef read_bytes(path):\n    with open(path, \'rb\') as f:\n        return f.read()\n\n\ndef write_bytes(path, data):\n    with open(path, \'wb\') as f:\n        f.write(data)\n\n\ndef chunk(data, rec_len):\n    n = len(data) // rec_len\n    records = [data[i * rec_len:(i + 1) * rec_len] for i in range(n)]\n    leftover = data[n * rec_len:]\n    return records, leftover\n\n\ndef amount_value(s):\n    # numeric field: digits kept, spaces (and any non-digit) treated as 0\n    return int(\'\'.join(c if c.isdigit() else \'0\' for c in s.decode(\'latin-1\')))\n\n\ndef store_unsigned(v):\n    if v < 0:\n        v = -v\n    v = v % 10 ** 10\n    return str(v).zfill(10).encode(\'latin-1\')\n\n\ndef main():\n    inp = read_bytes(INPUT)\n    if len(inp) == 0:\n        sys.stdout.write("Error: Input file is empty\\n")\n        return\n\n    rec = inp[:IN_LEN]\n    rec = rec + b\' \' * (IN_LEN - len(rec))\n\n    buyer = rec[0:4]\n    seller = rec[4:8]\n    book = rec[8:12]\n    amt = amount_value(rec[12:22])\n\n    acc_records, acc_left = chunk(read_bytes(ACCOUNTS), ACC_LEN)\n    book_records, book_left = chunk(read_bytes(BOOKS), BOOK_LEN)\n\n    buyer_found = any(r[0:4] == buyer for r in acc_records)\n    seller_found = any(r[0:4] == seller for r in acc_records)\n    book_found = any(r[0:4] == book for r in book_records)\n    valid_owner = any(r[0:4] == book and r[24:28] == seller for r in book_records)\n\n    # validate paragraph ends with DISPLAY " " (a space line)\n    sys.stdout.write(" \\n")\n\n    if not (buyer_found and seller_found and book_found and valid_owner):\n        sys.stdout.write("Transaction failed due to validation errors\\n")\n        return\n\n    # accounts\n    new_acc = []\n    for r in acc_records:\n        rid = r[0:4]\n        rname = r[4:24]\n        bal = int(r[24:34].decode(\'latin-1\'))\n        if rid == buyer:\n            bal = bal - amt\n        if rid == seller:\n            bal = bal + amt\n        new_acc.append(rid + rname + store_unsigned(bal))\n    write_bytes(ACCOUNTS, b\'\'.join(new_acc) + acc_left)\n\n    # books\n    new_books = []\n    for r in book_records:\n        bid = r[0:4]\n        btitle = r[4:24]\n        owner = r[24:28]\n        if bid == book:\n            owner = buyer\n        new_books.append(bid + btitle + owner)\n    write_bytes(BOOKS, b\'\'.join(new_books) + book_left)\n\n    # transactions (append)\n    trans_records, trans_left = chunk(read_bytes(TRANS), TRANS_LEN)\n    new_rec = book + str(amt).zfill(10).encode(\'latin-1\') + seller + buyer\n    trans_records.append(new_rec)\n    write_bytes(TRANS, b\'\'.join(trans_records) + trans_left)\n\n    sys.stdout.write("Transaction completed successfully\\n")\n\n\nif __name__ == \'__main__\':\n    main()\nPYEOF\necho WROTE; python3 -c "import ast; ast.parse(open(\'/app/program.py\').read()); print(\'SYNTAX_OK\')"\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
