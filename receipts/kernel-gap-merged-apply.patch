+        # Deferred-svh prefill: input hadamard + reconstruct + strided hgemm; the
+        # output hadamard runs once over the merged tensor in exl3_merged_epilogue.
+        bits = trellis.shape[2] // 16
+        k = trellis.shape[0] * 16
+        x_had = torch.empty_like(x)
+        ext.had_r_128(x, x_had, suh, None, 1.0)
+        chunk = min(n, _EXL3_RECONSTRUCT_SLICE_N)
