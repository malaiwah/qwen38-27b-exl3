+# KERNEL-GAP P2.3 (docs/47 F5.2/F8): reconstruct[j+1] never overlaps hgemm[j] on the
+# single-buffered scratch - the shared buffer is a WAR hazard and both kernels issue
+# on one stream. A 2-deep ring per geometry plus a side stream lets the (memory/int
+# pipe) reconstruct of the next matrix run under the (tensor pipe) cuBLAS of the
+# current one. Numerics are IDENTICAL: same kernels, same slice order, same buffers'
+# contents - only the issue stream and buffer identity change.
+#   VLLM_EXL3_RECONSTRUCT_OVERLAP: 0 = off (single buffer, one stream, old path);
+#   1 = ring for the two hot MLP geometries (gate/up 5120x17408 + down 17408x5120,
+#       68% of reconstruct bytes, +334 MB scratch); 2 = ring for every geometry.
+_EXL3_RECONSTRUCT_RING: dict[tuple[int, int, int], dict[str, Any]] = {}
+_EXL3_RECONSTRUCT_SIDE_STREAM: dict[int, Any] = {}
+_EXL3_RECONSTRUCT_HOT_KEYS = frozenset({(5120, 17408), (17408, 5120)})
+
+
+def _reconstruct_overlap_level() -> int:
+    raw = os.environ.get("VLLM_EXL3_RECONSTRUCT_OVERLAP")
+    if raw is None or not raw.strip():
+        return 0
+    try:
+        return max(0, int(raw.strip()))
+    except ValueError:
+        raise ValueError(
+            "VLLM_EXL3_RECONSTRUCT_OVERLAP must be 0, 1 or 2, got "
+            f"{raw!r}"
+        ) from None
+
+def _reconstruct_side_stream(device: torch.device) -> Any:
+    index = device.index if device.index is not None else torch.cuda.current_device()
+    stream = _EXL3_RECONSTRUCT_SIDE_STREAM.get(index)
+    if stream is None:
+        stream = torch.cuda.Stream(device=index)
+        _EXL3_RECONSTRUCT_SIDE_STREAM[index] = stream
+    return stream
+
+
+def _reconstruct_ring(device: torch.device, k: int, n: int) -> dict[str, Any] | None:
+    level = _reconstruct_overlap_level()
+    if level <= 0 or (level == 1 and (k, n) not in _EXL3_RECONSTRUCT_HOT_KEYS):
+        return None
+    index = device.index if device.index is not None else torch.cuda.current_device()
+    key = (index, k, n)
+    ring = _EXL3_RECONSTRUCT_RING.get(key)
+    if ring is None:
+        bufs = [
+            torch.empty((k, n), dtype=torch.float16, device=device) for _ in range(2)
+        ]
+        free = [torch.cuda.Event() for _ in range(2)]
+        ready = [torch.cuda.Event() for _ in range(2)]
+        current = torch.cuda.current_stream(device)
+        for ev in free:
+            # A wait on a never-recorded event is undefined; stamp both as free now.
+            ev.record(current)
+        ring = {"bufs": bufs, "free": free, "ready": ready, "idx": 0}
+        _EXL3_RECONSTRUCT_RING[key] = ring
+    return ring
+
+
