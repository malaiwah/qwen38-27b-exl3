+// Reconstruct + narrow to FP8 E4M3 with a transposed store.
+//
+// Why this exists: the prefill path materialises the weight and calls a dense GEMM,
+// and an FP8 GEMM is 1.5-1.8x faster than fp16 on the same shapes (measured, SM120).
+// But torch._scaled_mm requires the weight operand to be column-major, and converting
+// a reconstructed row-major (K, N) fp16 buffer costs a full extra pass over the weight
+// - measured at 2.5-3 ms per matrix, which is more than the GEMM saving. Emitting FP8
+// in the transposed layout directly from the tile already in shared memory removes
+// that pass entirely.
+//
+// The dequant and tensor-core-to-row-major shuffle are identical to reconstruct_kernel;
+// only the store differs. Each of the first 128 threads owns one output row (one N) and
+// writes its 16 K-values as a single 16-byte store.
+template <int K, int cb>
+__global__ __launch_bounds__(256)
+void reconstruct_fp8_kernel
+(
+    __nv_fp8_storage_t* __restrict__ g_unpacked,
+    const uint16_t* __restrict__ g_packed,
+    int packed_blocks_n,
+    int packed_n_offset,
+    int k_total,
+    float inv_scale,
+    const float* __restrict__ g_inv_scale
+)
+{
+    constexpr int packed_size = 256 * K / 16;
+
+    int t = threadIdx.x;
+    int lane_id = t % 32;
+    int warp_id = t / 32;
+    int k = blockIdx.y;
+    int n = blockIdx.x * 8;
+
+    __shared__ uint32_t s_packed[8][packed_size / 2];
+    g_packed += (k * packed_blocks_n + packed_n_offset + n) * packed_size;
+    if (t < packed_size)
+        ((int4*) s_packed)[t] = ((int4*) g_packed)[t];
+    __syncthreads();
+
+    register FragB frag[2];
+    dq_dispatch<K, cb>(s_packed[warp_id], lane_id * 8, frag[0], frag[1]);
+
+    __shared__ half2 tile[16][8][8];
+
+    half2 n0 = __shfl_down_sync(0xFFFFFFFF, frag[0][0], 4, 32);
+    half2 n1 = __shfl_down_sync(0xFFFFFFFF, frag[0][1], 4, 32);
+    half2 n2 = __shfl_down_sync(0xFFFFFFFF, frag[1][0], 4, 32);
+    half2 n3 = __shfl_down_sync(0xFFFFFFFF, frag[1][1], 4, 32);
+
+    if (!(lane_id & 4))
+    {
+        half2 m0 = __halves2half2(__low2half(frag[0][0]), __low2half(n0));
+        half2 m1 = __halves2half2(__high2half(frag[0][0]), __high2half(n0));
+        half2 m2 = __halves2half2(__low2half(frag[0][1]), __low2half(n1));
+        half2 m3 = __halves2half2(__high2half(frag[0][1]), __high2half(n1));
+        half2 m4 = __halves2half2(__low2half(frag[1][0]), __low2half(n2));
+        half2 m5 = __halves2half2(__high2half(frag[1][0]), __high2half(n2));
+        half2 m6 = __halves2half2(__low2half(frag[1][1]), __low2half(n3));
+        half2 m7 = __halves2half2(__high2half(frag[1][1]), __high2half(n3));
+        int r0 = (lane_id % 4) * 2;
+        int r1 = r0 + 1;
+        int r2 = r0 + 8;
+        int r3 = r0 + 9;
+        int c0 = lane_id / 8;
+        int c1 = c0 + 4;
+        tile[r0][warp_id][c0] = m0;
+        tile[r1][warp_id][c0] = m1;
+        tile[r2][warp_id][c0] = m2;
+        tile[r3][warp_id][c0] = m3;
+        tile[r0][warp_id][c1] = m4;
+        tile[r1][warp_id][c1] = m5;
+        tile[r2][warp_id][c1] = m6;
+        tile[r3][warp_id][c1] = m7;
+    }
+    __syncthreads();
+
+    // Transposed narrowing store: thread t owns column n_local of the tile, i.e. output
+    // row (n + n_local) of the (N, K) buffer, and gathers the 16 K-values of that column
+    // from shared memory. Lanes read consecutive columns, so each of the 16 gathers is a
+    // contiguous 64-byte shared read per warp.
+    //
+    // The scale is per output channel when g_inv_scale is non-null. A single per-tensor
+    // scale measured 0.0139 mean KLD worse than the fp16 path on a 27B model - E4M3 has
+    // three mantissa bits, so one scale for a whole matrix wastes most of them on the
+    // channels whose range is small. One scale per column costs one extra load per thread.
+    if (t < 128)
+    {
+        const half* s_tile = reinterpret_cast<const half*>(tile);
+        __align__(16) __nv_fp8_storage_t out_bytes[16];
+        size_t out_row = (size_t) (n * 16 + t);
+        float scale = g_inv_scale ? g_inv_scale[out_row] : inv_scale;
+        #pragma unroll
+        for (int r = 0; r < 16; ++r)
+        {
+            float v = __half2float(s_tile[r * 128 + t]) * scale;
+            out_bytes[r] = __nv_cvt_float_to_fp8(v, __NV_SATFINITE, __NV_E4M3);
+        }
+        int4* dst = (int4*) (g_unpacked + out_row * (size_t) k_total + (size_t) k * 16);
+        *dst = *reinterpret_cast<const int4*>(out_bytes);
+    }
+}
+
+#define __(i, cb) reconstruct_fp8_kernel<i, cb>
+constexpr auto reconstruct_fp8_kernel_instances = std::array
+{
+    __(1, 0), __(2, 0), __(3, 0), __(4, 0), __(5, 0), __(6, 0), __(7, 0), __(8, 0),
+    __(1, 1), __(2, 1), __(3, 1), __(4, 1), __(5, 1), __(6, 1), __(7, 1), __(8, 1),
+    __(1, 2), __(2, 2), __(3, 2), __(4, 2), __(5, 2), __(6, 2), __(7, 2), __(8, 2)
+};
+#undef __
+
+/*
+Reconstruct encoded+packed tensor into a transposed FP8 E4M3 buffer
+*/
+void reconstruct_fp8_slice
+(
+    at::Tensor unpacked_fp8,
+    at::Tensor packed,
+    int K,
+    bool mcg,
+    bool mul1,
+    int64_t n_offset,
+    double inv_scale,
+    const c10::optional<at::Tensor>& inv_scale_per_column
+)
+{
+    const at::cuda::OptionalCUDAGuard device_guard(unpacked_fp8.device());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+
+    TORCH_CHECK_SIZE(packed, 2, 256 * K / 16);
+    TORCH_CHECK_DTYPE(unpacked_fp8, kFloat8_e4m3fn);
+    TORCH_CHECK(unpacked_fp8.is_contiguous(), "unpacked_fp8 must be contiguous (N, K)");
+
+    int rows = packed.size(0);
+    int packed_cols = packed.size(1);
+    int k_total = rows * 16;
+
+    if (unpacked_fp8.numel() == 0)
+        return;
+
+    TORCH_CHECK(unpacked_fp8.size(1) == k_total,
+        "unpacked_fp8 second dimension must equal the packed K dimension");
+    TORCH_CHECK(unpacked_fp8.size(0) % 128 == 0, "unpacked_fp8 N dimension must be divisible by 128");
+    TORCH_CHECK(n_offset % 128 == 0, "n_offset must be divisible by 128");
+    TORCH_CHECK(n_offset >= 0, "n_offset must be non-negative");
+    TORCH_CHECK(n_offset + unpacked_fp8.size(0) <= packed.size(1) * 16,
+        "reconstruct slice exceeds packed tensor bounds");
+
+    int cols = unpacked_fp8.size(0) / 16;
+    int packed_n_offset = n_offset / 16;
+
+    dim3 blockDim(256);
+    dim3 gridDim(cols / 8, rows);
+
+    const float* per_column = nullptr;
+    if (inv_scale_per_column.has_value())
+    {
+        const at::Tensor& sc = inv_scale_per_column.value();
+        TORCH_CHECK_DTYPE(sc, kFloat);
+        TORCH_CHECK(sc.is_contiguous(), "inv_scale_per_column must be contiguous");
+        TORCH_CHECK(sc.numel() == unpacked_fp8.size(0),
+            "inv_scale_per_column must hold one scale per output channel of the slice");
+        per_column = (const float*) sc.data_ptr();
+    }
+
+    int cbi = K - 1;
+    if (mcg) cbi += 8;
+    else if (mul1) cbi += 16;
+
+    reconstruct_fp8_kernel_instances[cbi]<<<gridDim, blockDim, 0, stream>>>
+    (
+        (__nv_fp8_storage_t*) unpacked_fp8.data_ptr(),
+        (const uint16_t*) packed.data_ptr(),
+        packed_cols,
+        packed_n_offset,
+        k_total,
+        (float) inv_scale,
+        per_column
+    );
+    cuda_check(cudaPeekAtLastError());
+}
+
 /*
 Reconstruct encoded+packed tensor
 */
