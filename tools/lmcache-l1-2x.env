# LMCache L1 (CPU pinned DRAM) configuration used by every LMCache arm of
# receipts/lmcache-l1-2x.json on the 2x RTX PRO 6000 Blackwell host (314 GB DRAM).
#
# LMCache 0.5.2+glm52dcp.4 in the vllm:gg-r34-tb21-sr1 image has NO YAML config file: the
# image's wrapper /usr/local/bin/glm52-lmcache-wrapper.sh (sha256
# 5abf02609290d0ea7f1ed2a5cb9e67c08b331a362dd981b983d8ccfb71ae9eff) reads these environment
# variables and derives the `lmcache server` argv and the vLLM --kv-transfer-config from
# them. This file is therefore the whole configuration, and it is kept in the repo so the
# run is reproducible without the host.
#
#   source tools/lmcache-l1-2x.env
#   docker run ... $(printf -- '-e %s ' ${LMCACHE_VARS}) --entrypoint \
#     /usr/local/bin/glm52-lmcache-wrapper.sh vllm:gg-r34-tb21-sr1 /opt/venv/bin/vllm serve ...
#
# The equivalent single-process LMCache spelling of the L1 tier is
# `local_cpu: true` + `max_local_cpu_size: 160` (GiB); in the MP server it is --l1-size-gb.

# --- the tier this exercise exists to wire: CPU pinned DRAM -------------------------------
# 160 GiB of 314 GB. Budget: 21 GB of weights in page cache, ~40 GB resident for the engine
# core plus two TP worker processes, ~10 GB OS/agents => ~70 GB unallocated headroom.
# MEASURED on this host: the pool reached its full 171,798,691,840 bytes (160.0 GiB) of
# pinned DRAM within 13 s of server start despite --l1-use-lazy defaulting True, and peaked
# at 596 objects / 44.27 GiB used (27.7 % of the pool, zero L1 evictions) across the whole
# ladder. Host DRAM in use while serving: 184 of 314 GB, 130 GB still available.
LMCACHE_MODE=disk            # wrapper: L1 CPU DRAM + L2 fs_native disk (the ladder needs L2
                             # for the restart arms; LMCACHE_MODE=ram is L1 DRAM only)
LMCACHE_L1_GB=160            # -> lmcache server --l1-size-gb 160
LMCACHE_L1_INIT_GB=8         # -> --l1-init-size-gb 8   (lazy growth from here)

# --- geometry: pre-registered, do not change ---------------------------------------------
# 1600 is the mamba/attention block this model is served with ("Setting attention block size
# to 1600 tokens to ensure that attention page size is >= mamba page size") and the block the
# frozen prompt set is built around (prompts.mamba_block_tokens == 1600).
LMCACHE_CHUNK_SIZE=1600      # -> --chunk-size 1600

# --- L2 disk (886 GB free on /) -----------------------------------------------------------
LMCACHE_L2_GB=256            # -> --l2-adapter {"type":"fs_native",...,"max_capacity_gb":256}
LMCACHE_L2_WORKERS=8         # -> that adapter's num_workers (use_odirect false)
LMCACHE_L2_PATH=/l2/data     # -> --l2-adapter base_path

# --- workers ------------------------------------------------------------------------------
LMCACHE_MAX_GPU_WORKERS=2    # -> --max-gpu-workers 2, one per TP rank
LMCACHE_MAX_CPU_WORKERS=8    # -> --max-cpu-workers 8

# --- ports: pinned, NOT derived from PORT -------------------------------------------------
# nv-hostengine (nvidia-dcgm) owns 127.0.0.1:5555 on this host and must not be disturbed,
# so the wrapper's PORT-derived default (5555 + PORT-8000) is overridden explicitly.
LMCACHE_PORT=5796            # -> --port 5796 (ZMQ)
LMCACHE_HTTP_PORT=8330       # -> --http-port 8330 (/status, /healthcheck)
LMCACHE_PROMETHEUS_PORT=9331 # -> --prometheus-port 9331 (served EMPTY on this build; the
                             # /status endpoint carries the L1/L2 numbers instead)
LMCACHE_START_TIMEOUT=600

LMCACHE_VARS="LMCACHE_MODE LMCACHE_L1_GB LMCACHE_L1_INIT_GB LMCACHE_CHUNK_SIZE LMCACHE_L2_GB LMCACHE_L2_WORKERS LMCACHE_L2_PATH LMCACHE_MAX_GPU_WORKERS LMCACHE_MAX_CPU_WORKERS LMCACHE_PORT LMCACHE_HTTP_PORT LMCACHE_PROMETHEUS_PORT LMCACHE_START_TIMEOUT"

# --- what the wrapper derives from the above, verbatim -----------------------------------
# lmcache server --host 127.0.0.1 --port 5796 --chunk-size 1600 --max-gpu-workers 2
#   --max-cpu-workers 8 --l1-size-gb 160 --l1-init-size-gb 8 --l1-write-ttl-seconds 600
#   --l1-read-ttl-seconds 300 --eviction-policy LRU --eviction-trigger-watermark 0.90
#   --eviction-ratio 0.10 --l2-store-policy default --l2-prefetch-policy retain
#   --http-port 8330 --prometheus-port 9331
#   --l2-adapter '{"type":"fs_native","base_path":"/l2/data","num_workers":8,
#                  "use_odirect":false,"max_capacity_gb":256.0}'
#
# vllm serve ... --kv-transfer-config '{"kv_connector":"LMCacheMPConnector",
#   "kv_role":"kv_both","kv_connector_extra_config":{"lmcache.mp.host":"tcp://127.0.0.1",
#   "lmcache.mp.port":5796,"lmcache.mp.mq_timeout":60,"lmcache.mp.heartbeat_interval":5}}'
#
# The wrapper also forces PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False whenever LMCache
# is live (vLLM rejects the pairing because LMCache registers KV by address), so the harness
# pins that value for the L0 control too and the control stays one variable away.
#
# Server-side confirmation lines, measured:
#   "LMCache ready: mode=disk L1=160GB chunk=1600 L2=/l2/data"
#   /status: {"chunk_size":1600,"hash_algorithm":"blake3",
#             "l1_manager":{"memory_total_bytes":171798691840, ...}}
#   vLLM: KVTransferConfig(kv_connector='LMCacheMPConnector', kv_role='kv_both',
#         kv_load_failure_policy='fail', ...)
